				<crossref let="r" cid="c18020022.43">
				</crossref>
				fullness of, 
				<crossref let="s" cid="c18020022.44">
				</crossref>
				his sufficiency he will be in distress; the hand of everyone in misery will come against him.
			</v>
			<marker class="begin-verse" mid="v18020023">
			</marker>
			<v n="23">
				To fill 
				<crossref let="t" cid="c18020023.45">
				</crossref>
				his belly, 
				<crossref let="u" cid="c18020023.46">
				</crossref>
