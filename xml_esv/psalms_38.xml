			</v>
			<marker class="begin-verse" mid="v19038015">
			</marker>
			<v n="15">
				But for 
				<crossref let="d" cid="c19038015.29">
				</crossref>
				you, O, 
				<crossref let="e" cid="c19038015.30">
				</crossref>
