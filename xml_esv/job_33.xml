				<note nid="n18033021.21">
				</note>
			</v>
			<marker class="begin-verse" mid="v18033022">
			</marker>
			<v n="22">
				His soul 
				<crossref let="r" cid="c18033022.43">
				</crossref>
				draws near, 
				<crossref let="s" cid="c18033022.44">
				</crossref>
				the pit, and his life to those who bring death.
			</v>
			<marker class="begin-verse" mid="v18033023">
			</marker>
			<v n="23">
				If there 
				<crossref let="t" cid="c18033023.45">
				</crossref>
				be for, 
				<crossref let="u" cid="c18033023.46">
				</crossref>
