			</v>
			<marker class="begin-verse" mid="v20022008">
			</marker>
			<v n="8">
				Whoever sows 
				<crossref let="p" cid="c20022008.15">
				</crossref>
				injustice will, 
				<crossref let="q" cid="c20022008.16">
				</crossref>
