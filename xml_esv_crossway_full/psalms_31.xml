		<chapter num="31">
			<heading>
				Psalm 31
			</heading>
			<heading>
				Into Your Hand I Commit My Spirit
			</heading>
			<heading>
				To the choirmaster. A Psalm of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">in your<crossref let="r" cid="c19031001.4" />righteousness deliver me !</v>
			<marker class="begin-verse" mid="v19031002">
			</marker>
			<v n="2">a strong fortress to save me !</v>
			<marker class="begin-verse" mid="v19031003">
			</marker>
			<v n="3">and for your<crossref let="u" cid="c19031003.1" />name’s sake you lead me and guide me ;</v>
			<marker class="begin-verse" mid="v19031004">
			</marker>
			<v n="4">for you are my<crossref let="x" cid="c19031004.3" />refuge .</v>
			<marker class="begin-verse" mid="v19031005">
			</marker>
			<v n="5">you have redeemed me , O Lord ,<crossref let="z" cid="c19031005.2" />faithful God .</v>
			<marker class="begin-verse" mid="v19031006">
			</marker>
			<v n="6">but I trust in the Lord .</v>
			<marker class="begin-verse" mid="v19031007">
			</marker>
			<v n="7">you have<crossref let="d" cid="c19031007.1" />known the distress of my soul ,</v>
			<marker class="begin-verse" mid="v19031008">
			</marker>
			<v n="8">you have set my feet in<crossref let="f" cid="c19031008.2" />a broad place .</v>
			<marker class="begin-verse" mid="v19031009">
			</marker>
			<v n="9">my soul and my body also .</v>
			<marker class="begin-verse" mid="v19031010">
			</marker>
			<v n="10">and<crossref let="i" cid="c19031010.1" />my bones waste away .</v>
			<marker class="begin-verse" mid="v19031011">
			</marker>
			<v n="11">those who see me in the street<crossref let="l" cid="c19031011.3" />flee from me .</v>
			<marker class="begin-verse" mid="v19031012">
			</marker>
			<v n="12">I have become like<crossref let="n" cid="c19031012.2" />a broken vessel .</v>
			<marker class="begin-verse" mid="v19031013">
			</marker>
			<v n="13">as they plot to take my life .</v>
			<marker class="begin-verse" mid="v19031014">
			</marker>
			<v n="14">I say , “ You are my God . ”</v>
			<marker class="begin-verse" mid="v19031015">
			</marker>
			<v n="15">
				<crossref let="s" cid="c19031015.2" />rescue me from the hand of my enemies and from my persecutors !</v>
			<marker class="begin-verse" mid="v19031016">
			</marker>
			<v n="16">save me in your steadfast love !</v>
			<marker class="begin-verse" mid="v19031017">
			</marker>
			<v n="17">let them go<crossref let="v" cid="c19031017.2" />silently to Sheol .</v>
			<marker class="begin-verse" mid="v19031018">
			</marker>
			<v n="18">in pride and contempt .</v>
			<marker class="begin-verse" mid="v19031019">
			</marker>
			<v n="19">
				<crossref let="y" cid="c19031019.1" />in the sight of the children of mankind !</v>
			<marker class="begin-verse" mid="v19031020">
			</marker>
			<v n="20">from the strife of tongues .</v>
			<marker class="begin-verse" mid="v19031021">
			</marker>
			<v n="21">when I was in<crossref let="c" cid="c19031021.2" />a besieged city .</v>
			<marker class="begin-verse" mid="v19031022">
			</marker>
			<v n="22">when I cried to you for help .</v>
			<marker class="begin-verse" mid="v19031023">
			</marker>
			<v n="23">but abundantly<crossref let="h" cid="c19031023.2" />repays the one who acts in pride .</v>
			<marker class="begin-verse" mid="v19031024">
			</marker>
			<v n="24">all you who wait for the Lord !</v>
			<marker class="begin-verse" mid="v19031025">
			</marker>
			<end-paragraph>
			</end-paragraph>
