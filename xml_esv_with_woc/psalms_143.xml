			<heading>
				Psalm 143
			</heading>
			<heading>
				My Soul Thirsts for You
			</heading>
			<heading>
				A Psalm of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">In your faithfulness answer me, in your<crossref let="c" cid="c19143001.1" />righteousness!</v>
			<marker class="begin-verse" mid="v19143002">
			</marker>
			<v n="2">for no one living is righteous<crossref let="e" cid="c19143002.1" />before you.</v>
			<marker class="begin-verse" mid="v19143003">
			</marker>
			<v n="3">
				<crossref let="g" cid="c19143003.1" />he has made me sit in darkness like those long dead.</v>
			<marker class="begin-verse" mid="v19143004">
			</marker>
			<v n="4">my heart within me is appalled.</v>
			<marker class="begin-verse" mid="v19143005">
			</marker>
			<v n="5">I ponder the work of your hands.</v>
			<marker class="begin-verse" mid="v19143006">
			</marker>
			<v n="6">
				<crossref let="l" cid="c19143006.1" />my soul thirsts for you like<crossref let="m" cid="c19143006.2" />a parched land. Selah</v>
			<marker class="begin-verse" mid="v19143007">
			</marker>
			<v n="7">
				<crossref let="q" cid="c19143007.3" />lest I be like those who go down to the pit.</v>
			<marker class="begin-verse" mid="v19143008">
			</marker>
			<v n="8">
				<crossref let="u" cid="c19143008.3" />for to you I lift up my soul.</v>
			<marker class="begin-verse" mid="v19143009">
			</marker>
			<v n="9">I have fled to you for refuge.</v>
			<marker class="begin-verse" mid="v19143010">
			</marker>
			<v n="10">on<crossref let="z" cid="c19143010.4" />level ground!</v>
			<marker class="begin-verse" mid="v19143011">
			</marker>
			<v n="11">bring my soul out of trouble!</v>
			<marker class="begin-verse" mid="v19143012">
			</marker>
			<v n="12">servant.</v>
			<marker class="begin-verse" mid="v19143013">
			</marker>
