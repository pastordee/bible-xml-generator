			<heading>
				To Your Name Give Glory
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">
				<crossref let="b" cid="c19115001.2" />for the sake of your steadfast love and your faithfulness!</v>
			<marker class="begin-verse" mid="v19115002">
			</marker>
			<v n="2">
				<crossref let="c" cid="c19115002.1" />“Where is their God?”</v>
			<marker class="begin-verse" mid="v19115003">
			</marker>
			<v n="3">
				<crossref let="e" cid="c19115003.2" />he does all that he pleases.</v>
			<marker class="begin-verse" mid="v19115004">
			</marker>
			<v n="4">
				<crossref let="g" cid="c19115004.2" />the work of human hands.</v>
			<marker class="begin-verse" mid="v19115005">
			</marker>
			<v n="5">eyes, but do not see.</v>
			<marker class="begin-verse" mid="v19115006">
			</marker>
			<v n="6">noses, but do not smell.</v>
			<marker class="begin-verse" mid="v19115007">
			</marker>
			<v n="7">and they do not make a sound in their throat.</v>
			<marker class="begin-verse" mid="v19115008">
			</marker>
			<v n="8">so do all who trust in them.</v>
			<marker class="begin-verse" mid="v19115009">
			</marker>
			<v n="9">He is their<crossref let="l" cid="c19115009.3" />help and their shield.</v>
			<marker class="begin-verse" mid="v19115010">
			</marker>
			<v n="10">their shield.</v>
			<marker class="begin-verse" mid="v19115011">
			</marker>
			<v n="11">He is their help and their shield.</v>
			<marker class="begin-verse" mid="v19115012">
			</marker>
			<v n="12">the house of Aaron;</v>
			<marker class="begin-verse" mid="v19115013">
			</marker>
			<v n="13">both the small and the great.</v>
			<marker class="begin-verse" mid="v19115014">
			</marker>
			<v n="14">you and your children!</v>
			<marker class="begin-verse" mid="v19115015">
			</marker>
			<v n="15">who made heaven and earth!</v>
			<marker class="begin-verse" mid="v19115016">
			</marker>
			<v n="16">but the earth he has given to the children of man.</v>
			<marker class="begin-verse" mid="v19115017">
			</marker>
			<v n="17">silence.</v>
			<marker class="begin-verse" mid="v19115018">
			</marker>
			<v n="18">Praise the Lord !</v>
			<marker class="begin-verse" mid="v19115019">
			</marker>
