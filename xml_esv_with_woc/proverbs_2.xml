		<chapter num="2">
			<heading>
				Proverbs 2
			</heading>
			<heading>
				The Value of Wisdom
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">and treasure up my commandments with you,</v>
			<marker class="begin-verse" mid="v20002002">
			</marker>
			<v n="2">and inclining your heart to understanding;</v>
			<marker class="begin-verse" mid="v20002003">
			</marker>
			<v n="3">for understanding,</v>
			<marker class="begin-verse" mid="v20002004">
			</marker>
			<v n="4">hidden treasures,</v>
			<marker class="begin-verse" mid="v20002005">
			</marker>
			<v n="5">and find the knowledge of God.</v>
			<marker class="begin-verse" mid="v20002006">
			</marker>
			<v n="6">from his mouth come knowledge and understanding;</v>
			<marker class="begin-verse" mid="v20002007">
			</marker>
			<v n="7">walk in integrity,</v>
			<marker class="begin-verse" mid="v20002008">
			</marker>
			<v n="8">saints.</v>
			<marker class="begin-verse" mid="v20002009">
			</marker>
			<v n="9">and equity, every good path;</v>
			<marker class="begin-verse" mid="v20002010">
			</marker>
			<v n="10">and knowledge will be pleasant to your soul;</v>
			<marker class="begin-verse" mid="v20002011">
			</marker>
			<v n="11">understanding will guard you,</v>
			<marker class="begin-verse" mid="v20002012">
			</marker>
			<v n="12">from men of perverted speech,</v>
			<marker class="begin-verse" mid="v20002013">
			</marker>
			<v n="13">walk in the ways of darkness,</v>
			<marker class="begin-verse" mid="v20002014">
			</marker>
			<v n="14">delight in the perverseness of evil,</v>
			<marker class="begin-verse" mid="v20002015">
			</marker>
			<v n="15">devious in their ways.</v>
			<marker class="begin-verse" mid="v20002016">
			</marker>
			<v n="16">her smooth words,</v>
			<marker class="begin-verse" mid="v20002017">
			</marker>
			<v n="17">the covenant of her God;</v>
			<marker class="begin-verse" mid="v20002018">
			</marker>
			<v n="18">and her paths to the departed;</v>
			<marker class="begin-verse" mid="v20002019">
			</marker>
			<v n="19">nor do they regain the paths of life.</v>
			<marker class="begin-verse" mid="v20002020">
			</marker>
			<v n="20">and keep to the paths of the righteous.</v>
			<marker class="begin-verse" mid="v20002021">
			</marker>
			<v n="21">and those with integrity will remain in it,</v>
			<marker class="begin-verse" mid="v20002022">
			</marker>
			<v n="22">rooted out of it.</v>
			<marker class="begin-verse" mid="v20002023">
			</marker>
			<end-paragraph>
			</end-paragraph>
