		<chapter num="3">
			<heading>
				Proverbs 3
			</heading>
			<heading>
				Trust in the LORD with All Your Heart
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">
				<crossref let="z" cid="c20003001.2" />but let your heart keep my commandments ,</v>
			<marker class="begin-verse" mid="v20003002">
			</marker>
			<v n="2">and<crossref let="b" cid="c20003002.2" />peace they will add to you .</v>
			<marker class="begin-verse" mid="v20003003">
			</marker>
			<v n="3">
				<crossref let="f" cid="c20003003.4" />write them on the tablet of your heart .</v>
			<marker class="begin-verse" mid="v20003004">
			</marker>
			<v n="4">in the sight of God and man .</v>
			<marker class="begin-verse" mid="v20003005">
			</marker>
			<v n="5">and<crossref let="j" cid="c20003005.2" />do not lean on your own understanding .</v>
			<marker class="begin-verse" mid="v20003006">
			</marker>
			<v n="6">and he<crossref let="l" cid="c20003006.2" />will make straight your paths .</v>
			<marker class="begin-verse" mid="v20003007">
			</marker>
			<v n="7">
				<crossref let="n" cid="c20003007.2" />fear the Lord , and turn away from evil .</v>
			<marker class="begin-verse" mid="v20003008">
			</marker>
			<v n="8">and<crossref let="p" cid="c20003008.2" />refreshment to your bones .</v>
			<marker class="begin-verse" mid="v20003009">
			</marker>
			<v n="9">and with<crossref let="q" cid="c20003009.1" />the firstfruits of all your produce ;</v>
			<marker class="begin-verse" mid="v20003010">
			</marker>
			<v n="10">and your vats will be bursting with wine .</v>
			<marker class="begin-verse" mid="v20003011">
			</marker>
			<v n="11">or be weary of his reproof ,</v>
			<marker class="begin-verse" mid="v20003012">
			</marker>
			<v n="12">as<crossref let="t" cid="c20003012.1" />a father the son in whom he delights .</v>
			<marker class="begin-verse" mid="v20003013">
			</marker>
			<v n="13">and the one who gets understanding ,</v>
			<marker class="begin-verse" mid="v20003014">
			</marker>
			<v n="14">and her profit better than<crossref let="w" cid="c20003014.2" />gold .</v>
			<marker class="begin-verse" mid="v20003015">
			</marker>
			<v n="15">and<crossref let="y" cid="c20003015.2" />nothing you desire can compare with her .</v>
			<marker class="begin-verse" mid="v20003016">
			</marker>
			<v n="16">in her left hand are<crossref let="a" cid="c20003016.1" />riches and honor .</v>
			<marker class="begin-verse" mid="v20003017">
			</marker>
			<v n="17">and all her paths are peace .</v>
			<marker class="begin-verse" mid="v20003018">
			</marker>
			<v n="18">those who hold her fast are called blessed .</v>
			<marker class="begin-verse" mid="v20003019">
			</marker>
			<v n="19">by understanding<crossref let="e" cid="c20003019.1" />he established the heavens ;</v>
			<marker class="begin-verse" mid="v20003020">
			</marker>
			<v n="20">and<crossref let="g" cid="c20003020.2" />the clouds drop down the dew .</v>
			<marker class="begin-verse" mid="v20003021">
			</marker>
			<v n="21">keep sound wisdom and discretion ,</v>
			<marker class="begin-verse" mid="v20003022">
			</marker>
			<v n="22">and<crossref let="j" cid="c20003022.2" />adornment for your neck .</v>
			<marker class="begin-verse" mid="v20003023">
			</marker>
			<v n="23">
				<crossref let="l" cid="c20003023.2" />and your foot will not stumble .</v>
			<marker class="begin-verse" mid="v20003024">
			</marker>
			<v n="24">when you lie down ,<crossref let="n" cid="c20003024.2" />your sleep will be sweet .</v>
			<marker class="begin-verse" mid="v20003025">
			</marker>
			<v n="25">or of<crossref let="p" cid="c20003025.2" />the ruin of the wicked , when it comes ,</v>
			<marker class="begin-verse" mid="v20003026">
			</marker>
			<v n="26">and will<crossref let="q" cid="c20003026.1" />keep your foot from being caught .</v>
			<marker class="begin-verse" mid="v20003027">
			</marker>
			<v n="27">when it is in your power to do it .</v>
			<marker class="begin-verse" mid="v20003028">
			</marker>
			<v n="28">tomorrow I will give it ” — when you have it with you .</v>
			<marker class="begin-verse" mid="v20003029">
			</marker>
			<v n="29">who<crossref let="u" cid="c20003029.2" />dwells trustingly beside you .</v>
			<marker class="begin-verse" mid="v20003030">
			</marker>
			<v n="30">when he has done you no harm .</v>
			<marker class="begin-verse" mid="v20003031">
			</marker>
			<v n="31">and do not choose any of his ways ,</v>
			<marker class="begin-verse" mid="v20003032">
			</marker>
			<v n="32">but the upright are<crossref let="z" cid="c20003032.2" />in his confidence .</v>
			<marker class="begin-verse" mid="v20003033">
			</marker>
			<v n="33">but he<crossref let="b" cid="c20003033.2" />blesses the dwelling of the righteous .</v>
			<marker class="begin-verse" mid="v20003034">
			</marker>
			<v n="34">
				<crossref let="e" cid="c20003034.3" />but to the humble he gives favor .</v>
			<marker class="begin-verse" mid="v20003035">
			</marker>
			<v n="35">but fools get disgrace .</v>
			<marker class="begin-verse" mid="v20003036">
			</marker>
			<end-paragraph>
			</end-paragraph>
			<footnotes>
				<footnotes-heading>Footnotes</footnotes-heading>
