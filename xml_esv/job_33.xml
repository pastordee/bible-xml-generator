				<crossref let="h" cid="c18033017.33">
				</crossref>
				may turn, 
				<crossref let="i" cid="c18033017.34">
				</crossref>
				man aside from his deed and conceal pride from a man;
			</v>
			<marker class="begin-verse" mid="v18033018">
			</marker>
