			<marker class="begin-verse" mid="v23033004">
			</marker>
			<v n="4">
				<crossref let="o" cid="c23033004.1" />as locusts leap , it is leapt upon .</v>
			<marker class="begin-verse" mid="v23033005">
			</marker>
			<v n="5">he will fill Zion with justice and righteousness ,</v>
			<marker class="begin-verse" mid="v23033006">
			</marker>
			<v n="6">the fear of the Lord is Zion’s treasure .</v>
			<marker class="begin-verse" mid="v23033007">
			</marker>
			<v n="7">
				<crossref let="r" cid="c23033007.1" />the envoys of peace weep bitterly .</v>
			<marker class="begin-verse" mid="v23033008">
			</marker>
			<v n="8">there is no regard for man .</v>
			<marker class="begin-verse" mid="v23033009">
			</marker>
			<v n="9">and Bashan and Carmel shake off their leaves .</v>
			<marker class="begin-verse" mid="v23033010">
			</marker>
			<v n="10">now I will be exalted .</v>
			<marker class="begin-verse" mid="v23033011">
			</marker>
			<v n="11">your breath is<crossref let="x" cid="c23033011.2" />a fire that will consume you .</v>
			<marker class="begin-verse" mid="v23033012">
			</marker>
			<v n="12">
				<crossref let="x" cid="c23033012.1" />like thorns cut down , that are burned in the fire . ”</v>
			<marker class="begin-verse" mid="v23033013">
			</marker>
			<v n="13">and you who are near , acknowledge my might .</v>
			<marker class="begin-verse" mid="v23033014">
			</marker>
			<v n="14">Who among us can dwell with everlasting burnings ? ”</v>
			<marker class="begin-verse" mid="v23033015">
			</marker>
			<v n="15">
				<crossref let="b" cid="c23033015.2" />and shuts his eyes from looking on evil ,</v>
			<marker class="begin-verse" mid="v23033016">
			</marker>
			<v n="16">
				<crossref let="c" cid="c23033016.1" />his bread will be given him ; his water will be sure .</v>
			<marker class="begin-verse" mid="v23033017">
			</marker>
			<v n="17">
				<crossref let="e" cid="c23033017.2" />they will see a land that stretches afar .</v>
			<marker class="begin-verse" mid="v23033018">
			</marker>
			<v n="18">Where is<crossref let="h" cid="c23033018.3" />he who counted the towers ? ”</v>
			<marker class="begin-verse" mid="v23033019">
			</marker>
			<v n="19">stammering in a tongue that you cannot understand .</v>
			<marker class="begin-verse" mid="v23033020">
			</marker>
			<v n="20">nor will any of its cords be broken .</v>
			<marker class="begin-verse" mid="v23033021">
			</marker>
			<v n="21">nor majestic ship can pass .</v>
			<marker class="begin-verse" mid="v23033022">
			</marker>
			<v n="22">the Lord is our<crossref let="q" cid="c23033022.3" />king ; he will save us .</v>
			<marker class="begin-verse" mid="v23033023">
			</marker>
