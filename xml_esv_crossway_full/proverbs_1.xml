	<book title="Proverbs" num="20" testament="old" bookAbbr="pro" version="ESV">
		<marker class="begin-verse" mid="v20001001">
		</marker>
		<chapter num="1">
			<heading>
				Proverbs 1
			</heading>
			<heading>
				The Beginning of Knowledge
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">
				<crossref let="a" cid="c20001001.1" />The proverbs of Solomon , son of David , king of Israel :</v>
			<marker class="begin-verse" mid="v20001002">
			</marker>
			<v n="2">to understand words of insight ,</v>
			<marker class="begin-verse" mid="v20001003">
			</marker>
			<v n="3">in<crossref let="b" cid="c20001003.1" />righteousness , justice , and equity ;</v>
			<marker class="begin-verse" mid="v20001004">
			</marker>
			<v n="4">knowledge and<crossref let="d" cid="c20001004.2" />discretion to the youth —</v>
			<marker class="begin-verse" mid="v20001005">
			</marker>
			<v n="5">and the one who understands obtain guidance ,</v>
			<marker class="begin-verse" mid="v20001006">
			</marker>
			<v n="6">
				<crossref let="f" cid="c20001006.1" />the words of the wise and their<crossref let="g" cid="c20001006.2" />riddles .</v>
			<marker class="begin-verse" mid="v20001007">
			</marker>
			<v n="7">fools despise wisdom and instruction .</v>
			<marker class="begin-verse" mid="v20001008">
			</marker>
			<v n="8">and forsake not your mother’s teaching ,</v>
			<marker class="begin-verse" mid="v20001009">
			</marker>
			<v n="9">and<crossref let="k" cid="c20001009.2" />pendants for your neck .</v>
			<marker class="begin-verse" mid="v20001010">
			</marker>
			<v n="10">do not consent .</v>
			<marker class="begin-verse" mid="v20001011">
			</marker>
			<v n="11">
				<crossref let="n" cid="c20001011.2" />let us ambush the innocent without reason ;</v>
			<marker class="begin-verse" mid="v20001012">
			</marker>
			<v n="12">and whole , like<crossref let="p" cid="c20001012.2" />those who go down to the pit ;</v>
			<marker class="begin-verse" mid="v20001013">
			</marker>
			<v n="13">we shall fill our houses with plunder ;</v>
			<marker class="begin-verse" mid="v20001014">
			</marker>
			<v n="14">we will all have one purse ” —</v>
			<marker class="begin-verse" mid="v20001015">
			</marker>
			<v n="15">
				<crossref let="r" cid="c20001015.2" />hold back your foot from their paths ,</v>
			<marker class="begin-verse" mid="v20001016">
			</marker>
			<v n="16">and they make haste to shed blood .</v>
			<marker class="begin-verse" mid="v20001017">
			</marker>
			<v n="17">in the sight of any bird ,</v>
			<marker class="begin-verse" mid="v20001018">
			</marker>
			<v n="18">they<crossref let="u" cid="c20001018.1" />set an ambush for their own lives .</v>
			<marker class="begin-verse" mid="v20001019">
			</marker>
			<v n="19">
				<crossref let="x" cid="c20001019.3" />it takes away the life of its possessors .</v>
			<marker class="begin-verse" mid="v20001020">
			</marker>
			<v n="20">in the markets she raises her voice ;</v>
			<marker class="begin-verse" mid="v20001021">
			</marker>
			<v n="21">at<crossref let="z" cid="c20001021.1" />the entrance of the city gates she speaks :</v>
			<marker class="begin-verse" mid="v20001022">
			</marker>
			<v n="22">and fools<crossref let="c" cid="c20001022.3" />hate knowledge ?</v>
			<marker class="begin-verse" mid="v20001023">
			</marker>
			<v n="23">I will make my words known to you .</v>
			<marker class="begin-verse" mid="v20001024">
			</marker>
			<v n="24">have<crossref let="g" cid="c20001024.3" />stretched out my hand and no one has heeded ,</v>
			<marker class="begin-verse" mid="v20001025">
			</marker>
			<v n="25">and<crossref let="i" cid="c20001025.2" />would have none of my reproof ,</v>
			<marker class="begin-verse" mid="v20001026">
			</marker>
			<v n="26">I will mock when<crossref let="k" cid="c20001026.2" />terror strikes you ,</v>
			<marker class="begin-verse" mid="v20001027">
			</marker>
			<v n="27">when distress and anguish come upon you .</v>
			<marker class="begin-verse" mid="v20001028">
			</marker>
			<v n="28">they will seek me diligently but will not find me .</v>
			<marker class="begin-verse" mid="v20001029">
			</marker>
			<v n="29">and<crossref let="n" cid="c20001029.2" />did not choose the fear of the Lord ,</v>
			<marker class="begin-verse" mid="v20001030">
			</marker>
			<v n="30">and<crossref let="i" cid="c20001030.2" />despised all my reproof ,</v>
			<marker class="begin-verse" mid="v20001031">
			</marker>
			<v n="31">and have<crossref let="p" cid="c20001031.2" />their fill of their own devices .</v>
			<marker class="begin-verse" mid="v20001032">
			</marker>
			<v n="32">and<crossref let="r" cid="c20001032.2" />the complacency of fools destroys them ;</v>
			<marker class="begin-verse" mid="v20001033">
			</marker>
			<v n="33">and will be<crossref let="t" cid="c20001033.2" />at ease , without dread of disaster . ”</v>
			<marker class="begin-verse" mid="v20001034">
			</marker>
			<end-paragraph>
			</end-paragraph>
			<footnotes>
				<footnotes-heading>Footnotes</footnotes-heading>
				<footnote id="1">1:23 Or *Will you turn away at my reproof?*</footnote>
			</footnotes>
		</chapter>
	</book>
</bible>
