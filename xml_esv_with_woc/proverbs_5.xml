		<chapter num="5">
			<heading>
				Proverbs 5
			</heading>
			<heading>
				Warning Against Adultery
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">incline your ear to my understanding,</v>
			<marker class="begin-verse" mid="v20005002">
			</marker>
			<v n="2">guard knowledge.</v>
			<marker class="begin-verse" mid="v20005003">
			</marker>
			<v n="3">smoother than oil,</v>
			<marker class="begin-verse" mid="v20005004">
			</marker>
			<v n="4">a two-edged sword.</v>
			<marker class="begin-verse" mid="v20005005">
			</marker>
			<v n="5">her steps follow the path to Sheol;</v>
			<marker class="begin-verse" mid="v20005006">
			</marker>
			<v n="6">her ways wander, and she does not know it.</v>
			<marker class="begin-verse" mid="v20005007">
			</marker>
			<v n="7">and do not depart from the words of my mouth.</v>
			<marker class="begin-verse" mid="v20005008">
			</marker>
			<v n="8">and do not go near the door of her house,</v>
			<marker class="begin-verse" mid="v20005009">
			</marker>
			<v n="9">and your years to the merciless,</v>
			<marker class="begin-verse" mid="v20005010">
			</marker>
			<v n="10">labors go to the house of a foreigner,</v>
			<marker class="begin-verse" mid="v20005011">
			</marker>
			<v n="11">when your flesh and body are consumed,</v>
			<marker class="begin-verse" mid="v20005012">
			</marker>
			<v n="12">despised reproof!</v>
			<marker class="begin-verse" mid="v20005013">
			</marker>
			<v n="13">or incline my ear to my instructors.</v>
			<marker class="begin-verse" mid="v20005014">
			</marker>
			<v n="14">in the assembled congregation.”</v>
			<marker class="begin-verse" mid="v20005015">
			</marker>
			<v n="15">flowing water from your own well.</v>
			<marker class="begin-verse" mid="v20005016">
			</marker>
			<v n="16">in the streets?</v>
			<marker class="begin-verse" mid="v20005017">
			</marker>
			<v n="17">and not for strangers with you.</v>
			<marker class="begin-verse" mid="v20005018">
			</marker>
			<v n="18">the wife of your youth,</v>
			<marker class="begin-verse" mid="v20005019">
			</marker>
			<v n="19">be intoxicated always in her love.</v>
			<marker class="begin-verse" mid="v20005020">
			</marker>
			<v n="20">an adulteress?</v>
			<marker class="begin-verse" mid="v20005021">
			</marker>
			<v n="21">ponders all his paths.</v>
			<marker class="begin-verse" mid="v20005022">
			</marker>
			<v n="22">and he is held fast in the cords of his sin.</v>
			<marker class="begin-verse" mid="v20005023">
			</marker>
			<v n="23">led astray.</v>
			<marker class="begin-verse" mid="v20005024">
			</marker>
			<end-paragraph>
			</end-paragraph>
