		<chapter num="7">
			<heading>
				Proverbs 7
			</heading>
			<heading>
				Warning Against the Adulteress
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">treasure up my commandments with you;</v>
			<marker class="begin-verse" mid="v20007002">
			</marker>
			<v n="2">the apple of your eye;</v>
			<marker class="begin-verse" mid="v20007003">
			</marker>
			<v n="3">write them on the tablet of your heart.</v>
			<marker class="begin-verse" mid="v20007004">
			</marker>
			<v n="4">and call insight your intimate friend,</v>
			<marker class="begin-verse" mid="v20007005">
			</marker>
			<v n="5">the adulteress with her smooth words.</v>
			<marker class="begin-verse" mid="v20007006">
			</marker>
			<v n="6">I have looked out through my lattice,</v>
			<marker class="begin-verse" mid="v20007007">
			</marker>
			<v n="7">lacking sense,</v>
			<marker class="begin-verse" mid="v20007008">
			</marker>
			<v n="8">taking the road to her house</v>
			<marker class="begin-verse" mid="v20007009">
			</marker>
			<v n="9">the time of night and darkness.</v>
			<marker class="begin-verse" mid="v20007010">
			</marker>
			<v n="10">dressed as a prostitute, wily of heart.</v>
			<marker class="begin-verse" mid="v20007011">
			</marker>
			<v n="11">her feet do not stay at home;</v>
			<marker class="begin-verse" mid="v20007012">
			</marker>
			<v n="12">lies in wait.</v>
			<marker class="begin-verse" mid="v20007013">
			</marker>
			<v n="13">bold face she says to him,</v>
			<marker class="begin-verse" mid="v20007014">
			</marker>
			<v n="14">paid my vows;</v>
			<marker class="begin-verse" mid="v20007015">
			</marker>
			<v n="15">to seek you eagerly, and I have found you.</v>
			<marker class="begin-verse" mid="v20007016">
			</marker>
			<v n="16">Egyptian linen;</v>
			<marker class="begin-verse" mid="v20007017">
			</marker>
			<v n="17">cinnamon.</v>
			<marker class="begin-verse" mid="v20007018">
			</marker>
			<v n="18">let us delight ourselves with love.</v>
			<marker class="begin-verse" mid="v20007019">
			</marker>
			<v n="19">he has gone on a long journey;</v>
			<marker class="begin-verse" mid="v20007020">
			</marker>
			<v n="20">at full moon he will come home.”</v>
			<marker class="begin-verse" mid="v20007021">
			</marker>
			<v n="21">her smooth talk she compels him.</v>
			<marker class="begin-verse" mid="v20007022">
			</marker>
			<v n="22">or as a stag is caught fast</v>
			<marker class="begin-verse" mid="v20007023">
			</marker>
			<v n="23">he does not know that it will cost him his life.</v>
			<marker class="begin-verse" mid="v20007024">
			</marker>
			<v n="24">and be attentive to the words of my mouth.</v>
			<marker class="begin-verse" mid="v20007025">
			</marker>
			<v n="25">do not stray into her paths,</v>
			<marker class="begin-verse" mid="v20007026">
			</marker>
			<v n="26">a mighty throng.</v>
			<marker class="begin-verse" mid="v20007027">
			</marker>
			<v n="27">going down to the chambers of death.</v>
			<marker class="begin-verse" mid="v20007028">
			</marker>
			<end-paragraph>
			</end-paragraph>
