				<crossref let="k" cid="c19038005.10">
				</crossref>
				fester because of my foolishness,
			</v>
			<marker class="begin-verse" mid="v19038006">
			</marker>
			<v n="6">
				I am 
				<crossref let="l" cid="c19038006.11">
				</crossref>
				utterly bowed, 
				<crossref let="m" cid="c19038006.12">
				</crossref>
