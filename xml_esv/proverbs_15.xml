			</v>
			<marker class="begin-verse" mid="v20015024">
			</marker>
			<v n="24">
				The path 
				<crossref let="v" cid="c20015024.47">
				</crossref>
				of life, 
				<crossref let="w" cid="c20015024.48">
				</crossref>
