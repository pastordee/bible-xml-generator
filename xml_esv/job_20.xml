			</v>
			<marker class="begin-verse" mid="v18020017">
			</marker>
			<v n="17">
				He will 
				<crossref let="h" cid="c18020017.33">
				</crossref>
				not look, 
				<crossref let="i" cid="c18020017.34">
				</crossref>
