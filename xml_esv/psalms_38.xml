				<crossref let="f" cid="c19038016.31">
				</crossref>
				said, “Only, 
				<crossref let="g" cid="c19038016.32">
				</crossref>
				let them not rejoice over me, who boast against me when my foot slips!”
			</v>
			<marker class="begin-verse" mid="v19038017">
			</marker>
			<v n="17">
				For I 
				<crossref let="h" cid="c19038017.33">
				</crossref>
				am ready, 
				<crossref let="i" cid="c19038017.34">
				</crossref>
				to fall, and my pain is ever before me.
			</v>
			<marker class="begin-verse" mid="v19038018">
			</marker>
			<v n="18">
				I confess 
				<crossref let="j" cid="c19038018.35">
				</crossref>
				my iniquity;, 
				<crossref let="k" cid="c19038018.36">
				</crossref>
				I am sorry for my sin.
				<note nid="n19038018.18">
				</note>
			</v>
			<marker class="begin-verse" mid="v19038019">
			</marker>
			<v n="19">
				But my 
				<crossref let="l" cid="c19038019.37">
				</crossref>
				foes are, 
				<crossref let="m" cid="c19038019.38">
				</crossref>
