		<chapter num="6">
			<heading>
				Proverbs 6
			</heading>
			<heading>
				Practical Warnings
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">given your pledge for a stranger,</v>
			<marker class="begin-verse" mid="v20006002">
			</marker>
			<v n="2">caught in the words of your mouth,</v>
			<marker class="begin-verse" mid="v20006003">
			</marker>
			<v n="3">plead urgently with your neighbor.</v>
			<marker class="begin-verse" mid="v20006004">
			</marker>
			<v n="4">and your eyelids no slumber;</v>
			<marker class="begin-verse" mid="v20006005">
			</marker>
			<v n="5">like a bird from the hand of the fowler.</v>
			<marker class="begin-verse" mid="v20006006">
			</marker>
			<v n="6">consider her ways, and<crossref let="j" cid="c20006006.1" />be wise.</v>
			<marker class="begin-verse" mid="v20006007">
			</marker>
			<v n="7">officer, or ruler,</v>
			<marker class="begin-verse" mid="v20006008">
			</marker>
			<v n="8">gathers her food in harvest.</v>
			<marker class="begin-verse" mid="v20006009">
			</marker>
			<v n="9">When will you arise from your sleep?</v>
			<marker class="begin-verse" mid="v20006010">
			</marker>
			<v n="10">a little<crossref let="s" cid="c20006010.1" />folding of the hands to rest,</v>
			<marker class="begin-verse" mid="v20006011">
			</marker>
			<v n="11">and want like an armed man.</v>
			<marker class="begin-verse" mid="v20006012">
			</marker>
			<v n="12">goes about with<crossref let="v" cid="c20006012.1" />crooked speech,</v>
			<marker class="begin-verse" mid="v20006013">
			</marker>
			<v n="13">points with his finger,</v>
			<marker class="begin-verse" mid="v20006014">
			</marker>
			<v n="14">continually<crossref let="z" cid="c20006014.3" />sowing discord;</v>
			<marker class="begin-verse" mid="v20006015">
			</marker>
			<v n="15">beyond healing.</v>
			<marker class="begin-verse" mid="v20006016">
			</marker>
			<v n="16">seven that are an abomination to him:</v>
			<marker class="begin-verse" mid="v20006017">
			</marker>
			<v n="17">hands that shed innocent blood,</v>
			<marker class="begin-verse" mid="v20006018">
			</marker>
			<v n="18">feet that make haste to run to evil,</v>
			<marker class="begin-verse" mid="v20006019">
			</marker>
			<v n="19">sows discord among brothers.</v>
			<marker class="begin-verse" mid="v20006020">
			</marker>
			<v n="20">and forsake not your mother's teaching.</v>
			<marker class="begin-verse" mid="v20006021">
			</marker>
			<v n="21">tie them around your neck.</v>
			<marker class="begin-verse" mid="v20006022">
			</marker>
			<v n="22">and when you awake, they will talk with you.</v>
			<marker class="begin-verse" mid="v20006023">
			</marker>
			<v n="23">reproofs of discipline are the way of life,</v>
			<marker class="begin-verse" mid="v20006024">
			</marker>
			<v n="24">the adulteress.</v>
			<marker class="begin-verse" mid="v20006025">
			</marker>
			<v n="25">eyelashes;</v>
			<marker class="begin-verse" mid="v20006026">
			</marker>
			<v n="26">hunts down a precious life.</v>
			<marker class="begin-verse" mid="v20006027">
			</marker>
			<v n="27">and his clothes not be burned?</v>
			<marker class="begin-verse" mid="v20006028">
			</marker>
			<v n="28">and his feet not be scorched?</v>
			<marker class="begin-verse" mid="v20006029">
			</marker>
			<v n="29">will go unpunished.</v>
			<marker class="begin-verse" mid="v20006030">
			</marker>
			<v n="30">satisfy his appetite when he is hungry,</v>
			<marker class="begin-verse" mid="v20006031">
			</marker>
			<v n="31">he will give all the goods of his house.</v>
			<marker class="begin-verse" mid="v20006032">
			</marker>
			<v n="32">he who does it destroys himself.</v>
			<marker class="begin-verse" mid="v20006033">
			</marker>
			<v n="33">and his disgrace will not be wiped away.</v>
			<marker class="begin-verse" mid="v20006034">
			</marker>
			<v n="34">he takes revenge.</v>
			<marker class="begin-verse" mid="v20006035">
			</marker>
			<v n="35">he will refuse though you multiply gifts.</v>
			<marker class="begin-verse" mid="v20006036">
			</marker>
			<end-paragraph>
			</end-paragraph>
