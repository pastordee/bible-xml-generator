			<heading>
				In the Shadow of Your Wings
			</heading>
			<heading>
				A Prayer of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">Give ear to my prayer from lips free of deceit !</v>
			<marker class="begin-verse" mid="v19017002">
			</marker>
			<v n="2">Let your eyes behold the right !</v>
			<marker class="begin-verse" mid="v19017003">
			</marker>
			<v n="3">I have purposed that my mouth will not transgress .</v>
			<marker class="begin-verse" mid="v19017004">
			</marker>
			<v n="4">I have avoided the ways of the violent .</v>
			<marker class="begin-verse" mid="v19017005">
			</marker>
			<v n="5">my feet have not slipped .</v>
			<marker class="begin-verse" mid="v19017006">
			</marker>
			<v n="6">
				<crossref let="o" cid="c19017006.2" />incline your ear to me ; hear my words .</v>
			<marker class="begin-verse" mid="v19017007">
			</marker>
			<v n="7">from<crossref let="q" cid="c19017007.2" />their adversaries at your right hand .</v>
			<marker class="begin-verse" mid="v19017008">
			</marker>
			<v n="8">hide me in<crossref let="s" cid="c19017008.2" />the shadow of your wings ,</v>
			<marker class="begin-verse" mid="v19017009">
			</marker>
			<v n="9">my deadly enemies who<crossref let="t" cid="c19017009.1" />surround me .</v>
			<marker class="begin-verse" mid="v19017010">
			</marker>
			<v n="10">with their mouths they<crossref let="v" cid="c19017010.2" />speak arrogantly .</v>
			<marker class="begin-verse" mid="v19017011">
			</marker>
			<v n="11">they set their eyes to<crossref let="x" cid="c19017011.2" />cast us to the ground .</v>
			<marker class="begin-verse" mid="v19017012">
			</marker>
			<v n="12">as a young lion<crossref let="y" cid="c19017012.1" />lurking in ambush .</v>
			<marker class="begin-verse" mid="v19017013">
			</marker>
			<v n="13">Deliver my soul from the wicked by your sword ,</v>
			<marker class="begin-verse" mid="v19017014">
			</marker>
			<v n="14">and they leave their abundance to their infants .</v>
			<marker class="begin-verse" mid="v19017015">
			</marker>
			<v n="15">when I<crossref let="d" cid="c19017015.2" />awake , I shall be<crossref let="e" cid="c19017015.3" />satisfied with your likeness .</v>
			<marker class="begin-verse" mid="v19017016">
			</marker>
			<end-paragraph>
			</end-paragraph>
