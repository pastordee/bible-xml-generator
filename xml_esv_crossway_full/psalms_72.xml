			<heading>
				Give the King Your Justice
			</heading>
			<heading>
				Of Solomon.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">and your righteousness to the royal son !</v>
			<marker class="begin-verse" mid="v19072002">
			</marker>
			<v n="2">and your poor with justice !</v>
			<marker class="begin-verse" mid="v19072003">
			</marker>
			<v n="3">and the hills , in righteousness !</v>
			<marker class="begin-verse" mid="v19072004">
			</marker>
			<v n="4">and crush the oppressor !</v>
			<marker class="begin-verse" mid="v19072005">
			</marker>
			<v n="5">and as long as the moon ,<crossref let="v" cid="c19072005.2" />throughout all generations !</v>
			<marker class="begin-verse" mid="v19072006">
			</marker>
			<v n="6">like<crossref let="y" cid="c19072006.3" />showers that water the earth !</v>
			<marker class="begin-verse" mid="v19072007">
			</marker>
			<v n="7">and<crossref let="a" cid="c19072007.1" />peace abound , till the moon be no more !</v>
			<marker class="begin-verse" mid="v19072008">
			</marker>
			<v n="8">and from<crossref let="b" cid="c19072008.1" />the River to the<crossref let="c" cid="c19072008.2" />ends of the earth !</v>
			<marker class="begin-verse" mid="v19072009">
			</marker>
			<v n="9">and his enemies<crossref let="e" cid="c19072009.2" />lick the dust !</v>
			<marker class="begin-verse" mid="v19072010">
			</marker>
			<v n="10">bring gifts !</v>
			<marker class="begin-verse" mid="v19072011">
			</marker>
			<v n="11">all nations serve him !</v>
			<marker class="begin-verse" mid="v19072012">
			</marker>
			<v n="12">the poor and him who has no helper .</v>
			<marker class="begin-verse" mid="v19072013">
			</marker>
			<v n="13">and saves the lives of the needy .</v>
			<marker class="begin-verse" mid="v19072014">
			</marker>
			<v n="14">and<crossref let="m" cid="c19072014.1" />precious is their blood in his sight .</v>
			<marker class="begin-verse" mid="v19072015">
			</marker>
			<v n="15">and blessings invoked for him all the day !</v>
			<marker class="begin-verse" mid="v19072016">
			</marker>
			<v n="16">like the<crossref let="q" cid="c19072016.2" />grass of the field !</v>
			<marker class="begin-verse" mid="v19072017">
			</marker>
			<v n="17">
				<crossref let="t" cid="c19072017.3" />all nations call him blessed !</v>
			<marker class="begin-verse" mid="v19072018">
			</marker>
			<v n="18">who alone does<crossref let="v" cid="c19072018.2" />wondrous things .</v>
			<marker class="begin-verse" mid="v19072019">
			</marker>
			<v n="19">
				<crossref let="y" cid="c19072019.3" />Amen and Amen !</v>
			<marker class="begin-verse" mid="v19072020">
			</marker>
