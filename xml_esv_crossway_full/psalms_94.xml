			<marker class="begin-verse" mid="v19094004">
			</marker>
			<v n="4">all<crossref let="x" cid="c19094004.2" />the evildoers boast .</v>
			<marker class="begin-verse" mid="v19094005">
			</marker>
			<v n="5">and afflict your heritage .</v>
			<marker class="begin-verse" mid="v19094006">
			</marker>
