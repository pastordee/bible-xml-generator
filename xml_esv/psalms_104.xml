			<heading>
				O LORD My God, You Are Very Great
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">
				Bless the 
				<crossref let="b" cid="c19104001.1">
				</crossref>
				LORD, O, 
				<crossref let="c" cid="c19104001.2">
				</crossref>
