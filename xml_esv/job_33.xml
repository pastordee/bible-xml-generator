			</v>
			<marker class="begin-verse" mid="v18033021">
			</marker>
			<v n="21">
				His flesh 
				<crossref let="p" cid="c18033021.41">
				</crossref>
				is so, 
				<crossref let="q" cid="c18033021.42">
				</crossref>
