			<begin-paragraph>
			</begin-paragraph>
			<v n="1">so<crossref let="v" cid="c20026001.2" />honor is<crossref let="w" cid="c20026001.3" />not fitting for a fool .</v>
			<marker class="begin-verse" mid="v20026002">
			</marker>
			<v n="2">
				<crossref let="y" cid="c20026002.2" />a curse that is causeless does not alight .</v>
			<marker class="begin-verse" mid="v20026003">
			</marker>
			<v n="3">and<crossref let="a" cid="c20026003.1" />a rod for the back of fools .</v>
			<marker class="begin-verse" mid="v20026004">
			</marker>
			<v n="4">lest you be like him yourself .</v>
			<marker class="begin-verse" mid="v20026005">
			</marker>
			<v n="5">lest he be<crossref let="d" cid="c20026005.2" />wise in his own eyes .</v>
			<marker class="begin-verse" mid="v20026006">
			</marker>
