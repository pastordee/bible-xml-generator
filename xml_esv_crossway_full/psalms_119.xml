			<marker class="begin-verse" mid="v19119133">
			</marker>
			<v n="133">and let no iniquity<crossref let="b" cid="c19119133.2" />get dominion over me .</v>
			<marker class="begin-verse" mid="v19119134">
			</marker>
			<v n="134">that I may keep your precepts .</v>
			<marker class="begin-verse" mid="v19119135">
			</marker>
			<v n="135">and<crossref let="e" cid="c19119135.2" />teach me your statutes .</v>
			<marker class="begin-verse" mid="v19119136">
			</marker>
			<v n="136">because people<crossref let="g" cid="c19119136.2" />do not keep your law .</v>
			<marker class="begin-verse" mid="v19119137">
			</marker>
			<v n="137">and right are your rules .</v>
			<marker class="begin-verse" mid="v19119138">
			</marker>
			<v n="138">and in all<crossref let="j" cid="c19119138.2" />faithfulness .</v>
			<marker class="begin-verse" mid="v19119139">
			</marker>
			<v n="139">because my foes forget your words .</v>
			<marker class="begin-verse" mid="v19119140">
			</marker>
			<v n="140">and your servant<crossref let="m" cid="c19119140.2" />loves it .</v>
			<marker class="begin-verse" mid="v19119141">
			</marker>
			<v n="141">yet I do not<crossref let="n" cid="c19119141.1" />forget your precepts .</v>
			<marker class="begin-verse" mid="v19119142">
			</marker>
			<v n="142">and your law is<crossref let="o" cid="c19119142.1" />true .</v>
			<marker class="begin-verse" mid="v19119143">
			</marker>
			<v n="143">but your commandments are my<crossref let="p" cid="c19119143.1" />delight .</v>
			<marker class="begin-verse" mid="v19119144">
			</marker>
			<v n="144">
				<crossref let="q" cid="c19119144.1" />give me understanding that I may<crossref let="r" cid="c19119144.2" />live .</v>
			<marker class="begin-verse" mid="v19119145">
			</marker>
			<v n="145">I will<crossref let="t" cid="c19119145.2" />keep your statutes .</v>
			<marker class="begin-verse" mid="v19119146">
			</marker>
			<v n="146">that I may observe your testimonies .</v>
			<marker class="begin-verse" mid="v19119147">
			</marker>
			<v n="147">I<crossref let="v" cid="c19119147.2" />hope in your words .</v>
			<marker class="begin-verse" mid="v19119148">
			</marker>
			<v n="148">that I may meditate on your promise .</v>
			<marker class="begin-verse" mid="v19119149">
			</marker>
			<v n="149">O Lord ,<crossref let="x" cid="c19119149.1" />according to your justice<crossref let="y" cid="c19119149.2" />give me life .</v>
			<marker class="begin-verse" mid="v19119150">
			</marker>
			<v n="150">they are far from your law .</v>
			<marker class="begin-verse" mid="v19119151">
			</marker>
			<v n="151">and all your commandments are<crossref let="a" cid="c19119151.1" />true .</v>
			<marker class="begin-verse" mid="v19119152">
			</marker>
			<v n="152">that you have<crossref let="b" cid="c19119152.1" />founded them forever .</v>
			<marker class="begin-verse" mid="v19119153">
			</marker>
			<v n="153">for<crossref let="d" cid="c19119153.2" />I do not forget your law .</v>
			<marker class="begin-verse" mid="v19119154">
			</marker>
			<v n="154">
				<crossref let="f" cid="c19119154.2" />give me life according to your promise !</v>
			<marker class="begin-verse" mid="v19119155">
			</marker>
			<v n="155">
				<crossref let="h" cid="c19119155.2" />for they do not seek your statutes .</v>
			<marker class="begin-verse" mid="v19119156">
			</marker>
			<v n="156">
				<crossref let="f" cid="c19119156.1" />give me life according to your rules .</v>
			<marker class="begin-verse" mid="v19119157">
			</marker>
			<v n="157">but I do not<crossref let="k" cid="c19119157.2" />swerve from your testimonies .</v>
			<marker class="begin-verse" mid="v19119158">
			</marker>
			<v n="158">because they do not keep your commands .</v>
			<marker class="begin-verse" mid="v19119159">
			</marker>
			<v n="159">
				<crossref let="f" cid="c19119159.1" />Give me life , O Lord , according to your steadfast love .</v>
			<marker class="begin-verse" mid="v19119160">
			</marker>
			<v n="160">and every one of your<crossref let="q" cid="c19119160.3" />righteous rules endures forever .</v>
			<marker class="begin-verse" mid="v19119161">
			</marker>
			<v n="161">but my heart<crossref let="t" cid="c19119161.3" />stands in awe of your words .</v>
			<marker class="begin-verse" mid="v19119162">
			</marker>
			<v n="162">like one who<crossref let="u" cid="c19119162.2" />finds great spoil .</v>
			<marker class="begin-verse" mid="v19119163">
			</marker>
			<v n="163">but I love<crossref let="v" cid="c19119163.1" />your law .</v>
			<marker class="begin-verse" mid="v19119164">
			</marker>
			<v n="164">for your<crossref let="q" cid="c19119164.1" />righteous rules .</v>
			<marker class="begin-verse" mid="v19119165">
			</marker>
			<v n="165">
				<crossref let="x" cid="c19119165.2" />nothing can make them stumble .</v>
			<marker class="begin-verse" mid="v19119166">
			</marker>
			<v n="166">and I do your commandments .</v>
			<marker class="begin-verse" mid="v19119167">
			</marker>
			<v n="167">I<crossref let="v" cid="c19119167.1" />love them exceedingly .</v>
			<marker class="begin-verse" mid="v19119168">
			</marker>
			<v n="168">
				<crossref let="z" cid="c19119168.1" />for all my ways are before you .</v>
			<marker class="begin-verse" mid="v19119169">
			</marker>
			<v n="169">
				<crossref let="b" cid="c19119169.2" />give me understanding<crossref let="c" cid="c19119169.3" />according to your word !</v>
			<marker class="begin-verse" mid="v19119170">
			</marker>
			<v n="170">
				<crossref let="d" cid="c19119170.1" />deliver me according to your word .</v>
			<marker class="begin-verse" mid="v19119171">
			</marker>
			<v n="171">for you<crossref let="f" cid="c19119171.2" />teach me your statutes .</v>
			<marker class="begin-verse" mid="v19119172">
			</marker>
			<v n="172">for<crossref let="g" cid="c19119172.1" />all your commandments are right .</v>
			<marker class="begin-verse" mid="v19119173">
			</marker>
			<v n="173">for I have<crossref let="h" cid="c19119173.1" />chosen your precepts .</v>
			<marker class="begin-verse" mid="v19119174">
			</marker>
			<v n="174">and your law is my<crossref let="j" cid="c19119174.2" />delight .</v>
			<marker class="begin-verse" mid="v19119175">
			</marker>
			<v n="175">and let your rules help me .</v>
			<marker class="begin-verse" mid="v19119176">
			</marker>
			<v n="176">for I do not<crossref let="l" cid="c19119176.2" />forget your commandments .</v>
			<marker class="begin-verse" mid="v19119177">
			</marker>
			<end-paragraph>
			</end-paragraph>
