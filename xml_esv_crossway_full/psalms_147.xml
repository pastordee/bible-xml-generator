			<marker class="begin-verse" mid="v19147011">
			</marker>
			<v n="11">in those who<crossref let="e" cid="c19147011.2" />hope in his steadfast love .</v>
			<marker class="begin-verse" mid="v19147012">
			</marker>
			<v n="12">Praise your God , O Zion !</v>
			<marker class="begin-verse" mid="v19147013">
			</marker>
			<v n="13">he blesses your children within you .</v>
			<marker class="begin-verse" mid="v19147014">
			</marker>
			<v n="14">he<crossref let="h" cid="c19147014.2" />fills you with the<crossref let="i" cid="c19147014.3" />finest of the wheat .</v>
			<marker class="begin-verse" mid="v19147015">
			</marker>
