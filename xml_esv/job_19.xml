				</note>
			</v>
			<marker class="begin-verse" mid="v18019007">
			</marker>
			<v n="7">
				Behold, I 
				<crossref let="n" cid="c18019007.13">
				</crossref>
				cry out,, 
				<crossref let="o" cid="c18019007.14">
				</crossref>
