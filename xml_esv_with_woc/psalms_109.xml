		<chapter num="109">
			<heading>
				Psalm 109
			</heading>
			<heading>
				Help Me, O LORD My God
			</heading>
			<heading>
				To the choirmaster. A Psalm of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">God of my praise!</v>
			<marker class="begin-verse" mid="v19109002">
			</marker>
			<v n="2">speaking against me with lying tongues.</v>
			<marker class="begin-verse" mid="v19109003">
			</marker>
			<v n="3">without cause.</v>
			<marker class="begin-verse" mid="v19109004">
			</marker>
			<v n="4">give myself to prayer.</v>
			<marker class="begin-verse" mid="v19109005">
			</marker>
			<v n="5">and hatred for my love.</v>
			<marker class="begin-verse" mid="v19109006">
			</marker>
			<v n="6">at his right hand.</v>
			<marker class="begin-verse" mid="v19109007">
			</marker>
			<v n="7">prayer be counted as sin!</v>
			<marker class="begin-verse" mid="v19109008">
			</marker>
			<v n="8">office!</v>
			<marker class="begin-verse" mid="v19109009">
			</marker>
			<v n="9">and his wife a widow!</v>
			<marker class="begin-verse" mid="v19109010">
			</marker>
			<v n="10">seeking food far from the ruins they inhabit!</v>
			<marker class="begin-verse" mid="v19109011">
			</marker>
			<v n="11">strangers plunder the fruits of his toil!</v>
			<marker class="begin-verse" mid="v19109012">
			</marker>
			<v n="12">pity his fatherless children!</v>
			<marker class="begin-verse" mid="v19109013">
			</marker>
			<v n="13">name be blotted out in the second generation!</v>
			<marker class="begin-verse" mid="v19109014">
			</marker>
			<v n="14">blotted out!</v>
			<marker class="begin-verse" mid="v19109015">
			</marker>
			<v n="15">cut off the memory of them from the earth!</v>
			<marker class="begin-verse" mid="v19109016">
			</marker>
			<v n="16">the brokenhearted, to put them to death.</v>
			<marker class="begin-verse" mid="v19109017">
			</marker>
			<v n="17">He did not delight in blessing; may it be far from him!</v>
			<marker class="begin-verse" mid="v19109018">
			</marker>
			<v n="18">like oil into his bones!</v>
			<marker class="begin-verse" mid="v19109019">
			</marker>
			<v n="19">like a belt that he puts on every day!</v>
			<marker class="begin-verse" mid="v19109020">
			</marker>
			<v n="20">of those who speak evil against my life!</v>
			<marker class="begin-verse" mid="v19109021">
			</marker>
			<v n="21">steadfast love is good, deliver me!</v>
			<marker class="begin-verse" mid="v19109022">
			</marker>
			<v n="22">and my heart is stricken within me.</v>
			<marker class="begin-verse" mid="v19109023">
			</marker>
			<v n="23">shaken off like a locust.</v>
			<marker class="begin-verse" mid="v19109024">
			</marker>
			<v n="24">body has become gaunt, with no fat.</v>
			<marker class="begin-verse" mid="v19109025">
			</marker>
			<v n="25">wag their heads.</v>
			<marker class="begin-verse" mid="v19109026">
			</marker>
			<v n="26">Save me according to your steadfast love!</v>
			<marker class="begin-verse" mid="v19109027">
			</marker>
			<v n="27">you, O Lord , have done it!</v>
			<marker class="begin-verse" mid="v19109028">
			</marker>
			<v n="28">your servant will be glad!</v>
			<marker class="begin-verse" mid="v19109029">
			</marker>
			<v n="29">be wrapped in their own shame as in a cloak!</v>
			<marker class="begin-verse" mid="v19109030">
			</marker>
			<v n="30">praise him in the midst of the throng.</v>
			<marker class="begin-verse" mid="v19109031">
			</marker>
			<v n="31">to save him from those who condemn his soul to death.</v>
			<marker class="begin-verse" mid="v19109032">
			</marker>
			<end-paragraph>
			</end-paragraph>
			<footnotes>
				<footnotes-heading>Footnotes</footnotes-heading>
