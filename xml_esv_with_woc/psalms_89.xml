				<footnote id="2">89:6 Hebrew *the sons of God*, or *the sons of might*</footnote>
				<footnote id="3">89:19 Some Hebrew manuscripts *godly ones*</footnote>
				<footnote id="4">89:28 Or *will remain faithful*</footnote>
				<footnote id="5">89:30 Or *my just decrees*</footnote>
				<footnote id="6">89:50 Hebrew lacks *the insults*</footnote>
			</footnotes>
