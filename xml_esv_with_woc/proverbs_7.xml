				<footnote id="2">7:5 Hebrew *the foreign woman*</footnote>
				<footnote id="3">7:10 Hebrew *guarded in heart*</footnote>
				<footnote id="4">7:14 Hebrew *peace offerings*</footnote>
				<footnote id="5">7:22 Probable reading (compare Septuagint, Vulgate, Syriac); Hebrew *as a chain to discipline a fool*</footnote>
			</footnotes>
