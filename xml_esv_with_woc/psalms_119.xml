			<marker class="begin-verse" mid="v19119128">
			</marker>
			<v n="128">false way.</v>
			<marker class="begin-verse" mid="v19119129">
			</marker>
			<v n="129">keeps them.</v>
			<marker class="begin-verse" mid="v19119130">
			</marker>
			<v n="130">understanding to the simple.</v>
			<marker class="begin-verse" mid="v19119131">
			</marker>
			<v n="131">long for your commandments.</v>
			<marker class="begin-verse" mid="v19119132">
			</marker>
			<v n="132">as is your way with those who love your name.</v>
			<marker class="begin-verse" mid="v19119133">
			</marker>
			<v n="133">get dominion over me.</v>
			<marker class="begin-verse" mid="v19119134">
			</marker>
			<v n="134">that I may keep your precepts.</v>
			<marker class="begin-verse" mid="v19119135">
			</marker>
			<v n="135">teach me your statutes.</v>
			<marker class="begin-verse" mid="v19119136">
			</marker>
			<v n="136">do not keep your law.</v>
			<marker class="begin-verse" mid="v19119137">
			</marker>
			<v n="137">and right are your rules.</v>
			<marker class="begin-verse" mid="v19119138">
			</marker>
			<v n="138">faithfulness.</v>
			<marker class="begin-verse" mid="v19119139">
			</marker>
			<v n="139">because my foes forget your words.</v>
			<marker class="begin-verse" mid="v19119140">
			</marker>
			<v n="140">loves it.</v>
			<marker class="begin-verse" mid="v19119141">
			</marker>
			<v n="141">forget your precepts.</v>
			<marker class="begin-verse" mid="v19119142">
			</marker>
			<v n="142">true.</v>
			<marker class="begin-verse" mid="v19119143">
			</marker>
			<v n="143">delight.</v>
			<marker class="begin-verse" mid="v19119144">
			</marker>
			<v n="144">live.</v>
			<marker class="begin-verse" mid="v19119145">
			</marker>
			<v n="145">keep your statutes.</v>
			<marker class="begin-verse" mid="v19119146">
			</marker>
			<v n="146">that I may observe your testimonies.</v>
			<marker class="begin-verse" mid="v19119147">
			</marker>
			<v n="147">hope in your words.</v>
			<marker class="begin-verse" mid="v19119148">
			</marker>
			<v n="148">that I may meditate on your promise.</v>
			<marker class="begin-verse" mid="v19119149">
			</marker>
			<v n="149">give me life.</v>
			<marker class="begin-verse" mid="v19119150">
			</marker>
			<v n="150">they are far from your law.</v>
			<marker class="begin-verse" mid="v19119151">
			</marker>
			<v n="151">true.</v>
			<marker class="begin-verse" mid="v19119152">
			</marker>
			<v n="152">founded them forever.</v>
			<marker class="begin-verse" mid="v19119153">
			</marker>
			<v n="153">I do not forget your law.</v>
			<marker class="begin-verse" mid="v19119154">
			</marker>
			<v n="154">give me life according to your promise!</v>
			<marker class="begin-verse" mid="v19119155">
			</marker>
			<v n="155">for they do not seek your statutes.</v>
			<marker class="begin-verse" mid="v19119156">
