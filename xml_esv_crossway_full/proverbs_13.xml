		<chapter num="13">
			<heading>
				Proverbs 13
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">but<crossref let="q" cid="c20013001.1" />a scoffer does not listen to rebuke .</v>
			<marker class="begin-verse" mid="v20013002">
			</marker>
			<v n="2">but the desire of the treacherous<crossref let="s" cid="c20013002.2" />is for violence .</v>
			<marker class="begin-verse" mid="v20013003">
			</marker>
			<v n="3">
				<crossref let="u" cid="c20013003.2" />he who opens wide his lips<crossref let="v" cid="c20013003.3" />comes to ruin .</v>
			<marker class="begin-verse" mid="v20013004">
			</marker>
			<v n="4">while the soul of the diligent<crossref let="x" cid="c20013004.2" />is richly supplied .</v>
			<marker class="begin-verse" mid="v20013005">
			</marker>
			<v n="5">but the wicked brings shame and disgrace .</v>
			<marker class="begin-verse" mid="v20013006">
			</marker>
			<v n="6">but sin overthrows the wicked .</v>
			<marker class="begin-verse" mid="v20013007">
			</marker>
			<v n="7">
				<crossref let="b" cid="c20013007.2" />another pretends to be poor , yet has great wealth .</v>
			<marker class="begin-verse" mid="v20013008">
			</marker>
			<v n="8">but a poor man<crossref let="c" cid="c20013008.1" />hears no threat .</v>
			<marker class="begin-verse" mid="v20013009">
			</marker>
			<v n="9">but<crossref let="e" cid="c20013009.2" />the lamp of the wicked will be put out .</v>
			<marker class="begin-verse" mid="v20013010">
			</marker>
			<v n="10">but with those who take advice is wisdom .</v>
			<marker class="begin-verse" mid="v20013011">
			</marker>
			<v n="11">but whoever gathers little by little will increase it .</v>
			<marker class="begin-verse" mid="v20013012">
			</marker>
			<v n="12">
				<crossref let="h" cid="c20013012.1" />but a desire fulfilled is<crossref let="i" cid="c20013012.2" />a tree of life .</v>
			<marker class="begin-verse" mid="v20013013">
			</marker>
			<v n="13">but he who reveres the commandment will be<crossref let="l" cid="c20013013.3" />rewarded .</v>
			<marker class="begin-verse" mid="v20013014">
			</marker>
			<v n="14">that one may<crossref let="n" cid="c20013014.2" />turn away from the snares of death .</v>
			<marker class="begin-verse" mid="v20013015">
			</marker>
			<v n="15">but the way of the treacherous is their ruin .</v>
			<marker class="begin-verse" mid="v20013016">
			</marker>
			<v n="16">
				<crossref let="r" cid="c20013016.2" />but a fool flaunts his folly .</v>
			<marker class="begin-verse" mid="v20013017">
			</marker>
			<v n="17">but<crossref let="s" cid="c20013017.1" />a faithful envoy brings healing .</v>
			<marker class="begin-verse" mid="v20013018">
			</marker>
			<v n="18">
				<crossref let="u" cid="c20013018.2" />but whoever<crossref let="v" cid="c20013018.3" />heeds reproof is honored .</v>
			<marker class="begin-verse" mid="v20013019">
			</marker>
			<v n="19">but to turn away from evil is an abomination to fools .</v>
			<marker class="begin-verse" mid="v20013020">
			</marker>
			<v n="20">but the companion of fools will suffer harm .</v>
			<marker class="begin-verse" mid="v20013021">
			</marker>
			<v n="21">
				<crossref let="y" cid="c20013021.2" />but the righteous are rewarded with good .</v>
			<marker class="begin-verse" mid="v20013022">
			</marker>
			<v n="22">but<crossref let="a" cid="c20013022.1" />the sinner’s wealth is laid up for the righteous .</v>
			<marker class="begin-verse" mid="v20013023">
			</marker>
			<v n="23">but it is swept away through<crossref let="b" cid="c20013023.1" />injustice .</v>
			<marker class="begin-verse" mid="v20013024">
			</marker>
			<v n="24">but he who loves him is diligent to discipline him .</v>
			<marker class="begin-verse" mid="v20013025">
			</marker>
			<v n="25">but the belly of the wicked suffers want .</v>
			<marker class="begin-verse" mid="v20013026">
			</marker>
			<end-paragraph>
			</end-paragraph>
