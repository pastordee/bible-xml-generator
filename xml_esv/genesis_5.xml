			<marker class="begin-verse" mid="v01005021">
			</marker>
			<v n="21">
				When Enoch 
				<crossref let="p" cid="c01005021.41">
				</crossref>
				had lived, 
				<crossref let="q" cid="c01005021.42">
				</crossref>
