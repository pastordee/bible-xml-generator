				<crossref let="y" cid="c18020012.24">
				</crossref>
				in his mouth, though he hides it under his tongue,
				<note nid="n18020012.12">
				</note>
			</v>
			<marker class="begin-verse" mid="v18020013">
			</marker>
			<v n="13">
