				<note nid="n20015024.24">
				</note>
			</v>
			<marker class="begin-verse" mid="v20015025">
			</marker>
			<v n="25">
				The LORD 
				<crossref let="x" cid="c20015025.49">
				</crossref>
				tears down, 
				<crossref let="y" cid="c20015025.50">
				</crossref>
				the house of the proud but maintains the widow’s boundaries.
			</v>
			<marker class="begin-verse" mid="v20015026">
			</marker>
			<v n="26">
				The thoughts 
				<crossref let="z" cid="c20015026.51">
				</crossref>
				of the, 
				<crossref let="a" cid="c20015026.52">
				</crossref>
