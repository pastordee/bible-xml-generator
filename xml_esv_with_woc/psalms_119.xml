		<chapter num="119">
			<heading>
				Psalm 119
			</heading>
			<heading>
				Your Word Is a Lamp to My Feet
			</heading>
			<heading>
				Aleph
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">walk in the law of the Lord !</v>
			<marker class="begin-verse" mid="v19119002">
			</marker>
			<v n="2">seek him with their whole heart,</v>
			<marker class="begin-verse" mid="v19119003">
			</marker>
			<v n="3">but walk in his ways!</v>
			<marker class="begin-verse" mid="v19119004">
			</marker>
			<v n="4">to be kept diligently.</v>
			<marker class="begin-verse" mid="v19119005">
			</marker>
			<v n="5">in keeping your statutes!</v>
			<marker class="begin-verse" mid="v19119006">
			</marker>
			<v n="6">having my eyes fixed on all your commandments.</v>
			<marker class="begin-verse" mid="v19119007">
			</marker>
			<v n="7">your righteous rules.</v>
			<marker class="begin-verse" mid="v19119008">
			</marker>
			<v n="8">do not utterly forsake me!</v>
			<marker class="begin-verse" mid="v19119009">
			</marker>
			<v n="9">By guarding it according to your word.</v>
			<marker class="begin-verse" mid="v19119010">
			</marker>
			<v n="10">wander from your commandments!</v>
			<marker class="begin-verse" mid="v19119011">
			</marker>
			<v n="11">that I might not sin against you.</v>
			<marker class="begin-verse" mid="v19119012">
			</marker>
			<v n="12">teach me your statutes!</v>
			<marker class="begin-verse" mid="v19119013">
			</marker>
			<v n="13">all the rules of your mouth.</v>
			<marker class="begin-verse" mid="v19119014">
			</marker>
			<v n="14">riches.</v>
			<marker class="begin-verse" mid="v19119015">
			</marker>
			<v n="15">ways.</v>
			<marker class="begin-verse" mid="v19119016">
			</marker>
			<v n="16">I will not forget your word.</v>
			<marker class="begin-verse" mid="v19119017">
			</marker>
			<v n="17">that I may live and keep your word.</v>
			<marker class="begin-verse" mid="v19119018">
			</marker>
			<v n="18">wondrous things out of your law.</v>
			<marker class="begin-verse" mid="v19119019">
			</marker>
			<v n="19">hide not your commandments from me!</v>
			<marker class="begin-verse" mid="v19119020">
			</marker>
			<v n="20">for your rules at all times.</v>
			<marker class="begin-verse" mid="v19119021">
			</marker>
			<v n="21">wander from your commandments.</v>
			<marker class="begin-verse" mid="v19119022">
			</marker>
			<v n="22">for I have kept your testimonies.</v>
			<marker class="begin-verse" mid="v19119023">
			</marker>
			<v n="23">meditate on your statutes.</v>
			<marker class="begin-verse" mid="v19119024">
			</marker>
			<v n="24">counselors.</v>
			<marker class="begin-verse" mid="v19119025">
			</marker>
			<v n="25">according to your word!</v>
			<marker class="begin-verse" mid="v19119026">
			</marker>
			<v n="26">teach me your statutes!</v>
			<marker class="begin-verse" mid="v19119027">
			</marker>
			<v n="27">meditate on your wondrous works.</v>
			<marker class="begin-verse" mid="v19119028">
			</marker>
			<v n="28">strengthen me according to your word!</v>
			<marker class="begin-verse" mid="v19119029">
			</marker>
			<v n="29">teach me your law!</v>
			<marker class="begin-verse" mid="v19119030">
			</marker>
			<v n="30">set your rules before me.</v>
			<marker class="begin-verse" mid="v19119031">
			</marker>
			<v n="31">let me not be put to shame!</v>
			<marker class="begin-verse" mid="v19119032">
			</marker>
			<v n="32">enlarge my heart!</v>
			<marker class="begin-verse" mid="v19119033">
			</marker>
			<v n="33">to the end.</v>
			<marker class="begin-verse" mid="v19119034">
			</marker>
			<v n="34">and observe it with my whole heart.</v>
			<marker class="begin-verse" mid="v19119035">
			</marker>
			<v n="35">delight in it.</v>
			<marker class="begin-verse" mid="v19119036">
			</marker>
			<v n="36">selfish gain!</v>
			<marker class="begin-verse" mid="v19119037">
			</marker>
			<v n="37">give me life in your ways.</v>
			<marker class="begin-verse" mid="v19119038">
			</marker>
			<v n="38">that you may be feared.</v>
			<marker class="begin-verse" mid="v19119039">
			</marker>
			<v n="39">for your rules are good.</v>
			<marker class="begin-verse" mid="v19119040">
			</marker>
			<v n="40">in your righteousness give me life!</v>
			<marker class="begin-verse" mid="v19119041">
			</marker>
			<v n="41">according to your promise;</v>
			<marker class="begin-verse" mid="v19119042">
			</marker>
			<v n="42">for I trust in your word.</v>
			<marker class="begin-verse" mid="v19119043">
			</marker>
			<v n="43">hope is in your rules.</v>
			<marker class="begin-verse" mid="v19119044">
			</marker>
			<v n="44">forever and ever,</v>
			<marker class="begin-verse" mid="v19119045">
			</marker>
			<v n="45">sought your precepts.</v>
			<marker class="begin-verse" mid="v19119046">
			</marker>
			<v n="46">and shall not be put to shame,</v>
			<marker class="begin-verse" mid="v19119047">
			</marker>
			<v n="47">which I love.</v>
			<marker class="begin-verse" mid="v19119048">
			</marker>
			<v n="48">meditate on your statutes.</v>
			<marker class="begin-verse" mid="v19119049">
			</marker>
			<v n="49">hope.</v>
			<marker class="begin-verse" mid="v19119050">
			</marker>
			<v n="50">gives me life.</v>
			<marker class="begin-verse" mid="v19119051">
			</marker>
			<v n="51">turn away from your law.</v>
			<marker class="begin-verse" mid="v19119052">
			</marker>
			<v n="52">I take comfort, O Lord .</v>
			<marker class="begin-verse" mid="v19119053">
			</marker>
			<v n="53">who forsake your law.</v>
			<marker class="begin-verse" mid="v19119054">
			</marker>
			<v n="54">sojourning.</v>
			<marker class="begin-verse" mid="v19119055">
			</marker>
			<v n="55">and keep your law.</v>
			<marker class="begin-verse" mid="v19119056">
			</marker>
			<v n="56">I have kept your precepts.</v>
			<marker class="begin-verse" mid="v19119057">
			</marker>
			<v n="57">I promise to keep your words.</v>
			<marker class="begin-verse" mid="v19119058">
			</marker>
			<v n="58">according to your promise.</v>
			<marker class="begin-verse" mid="v19119059">
			</marker>
			<v n="59">I turn my feet to your testimonies;</v>
			<marker class="begin-verse" mid="v19119060">
			</marker>
			<v n="60">to keep your commandments.</v>
			<marker class="begin-verse" mid="v19119061">
			</marker>
			<v n="61">forget your law.</v>
			<marker class="begin-verse" mid="v19119062">
			</marker>
			<v n="62">righteous rules.</v>
			<marker class="begin-verse" mid="v19119063">
			</marker>
			<v n="63">of those who keep your precepts.</v>
			<marker class="begin-verse" mid="v19119064">
			</marker>
			<v n="64">teach me your statutes!</v>
			<marker class="begin-verse" mid="v19119065">
			</marker>
			<v n="65">according to your word.</v>
			<marker class="begin-verse" mid="v19119066">
			</marker>
			<v n="66">for I believe in your commandments.</v>
			<marker class="begin-verse" mid="v19119067">
			</marker>
			<v n="67">but now I keep your word.</v>
			<marker class="begin-verse" mid="v19119068">
			</marker>
			<v n="68">teach me your statutes.</v>
			<marker class="begin-verse" mid="v19119069">
			</marker>
			<v n="69">keep your precepts;</v>
			<marker class="begin-verse" mid="v19119070">
			</marker>
			<v n="70">delight in your law.</v>
			<marker class="begin-verse" mid="v19119071">
			</marker>
			<v n="71">that I might learn your statutes.</v>
			<marker class="begin-verse" mid="v19119072">
			</marker>
			<v n="72">than thousands of gold and silver pieces.</v>
			<marker class="begin-verse" mid="v19119073">
			</marker>
			<v n="73">give me understanding that I may learn your commandments.</v>
			<marker class="begin-verse" mid="v19119074">
			</marker>
			<v n="74">hoped in your word.</v>
			<marker class="begin-verse" mid="v19119075">
			</marker>
			<v n="75">faithfulness you have afflicted me.</v>
			<marker class="begin-verse" mid="v19119076">
			</marker>
			<v n="76">according to your promise to your servant.</v>
			<marker class="begin-verse" mid="v19119077">
			</marker>
			<v n="77">delight.</v>
			<marker class="begin-verse" mid="v19119078">
			</marker>
			<v n="78">meditate on your precepts.</v>
			<marker class="begin-verse" mid="v19119079">
			</marker>
			<v n="79">that they may know your testimonies.</v>
			<marker class="begin-verse" mid="v19119080">
			</marker>
			<v n="80">that I may not be put to shame!</v>
			<marker class="begin-verse" mid="v19119081">
			</marker>
			<v n="81">hope in your word.</v>
			<marker class="begin-verse" mid="v19119082">
			</marker>
			<v n="82">“When will you comfort me?”</v>
			<marker class="begin-verse" mid="v19119083">
			</marker>
			<v n="83">yet I have not forgotten your statutes.</v>
			<marker class="begin-verse" mid="v19119084">
			</marker>
			<v n="84">When will you judge those who persecute me?</v>
			<marker class="begin-verse" mid="v19119085">
			</marker>
			<v n="85">they do not live according to your law.</v>
			<marker class="begin-verse" mid="v19119086">
			</marker>
			<v n="86">help me!</v>
			<marker class="begin-verse" mid="v19119087">
			</marker>
			<v n="87">but I have not forsaken your precepts.</v>
			<marker class="begin-verse" mid="v19119088">
			</marker>
			<v n="88">that I may keep the testimonies of your mouth.</v>
			<marker class="begin-verse" mid="v19119089">
			</marker>
			<v n="89">is firmly fixed in the heavens.</v>
			<marker class="begin-verse" mid="v19119090">
			</marker>
			<v n="90">stands fast.</v>
			<marker class="begin-verse" mid="v19119091">
			</marker>
			<v n="91">for all things are your servants.</v>
			<marker class="begin-verse" mid="v19119092">
			</marker>
			<v n="92">I would have perished in my affliction.</v>
			<marker class="begin-verse" mid="v19119093">
			</marker>
			<v n="93">given me life.</v>
			<marker class="begin-verse" mid="v19119094">
			</marker>
			<v n="94">for I have sought your precepts.</v>
			<marker class="begin-verse" mid="v19119095">
			</marker>
			<v n="95">but I consider your testimonies.</v>
			<marker class="begin-verse" mid="v19119096">
			</marker>
			<v n="96">broad.</v>
			<marker class="begin-verse" mid="v19119097">
			</marker>
			<v n="97">meditation all the day.</v>
			<marker class="begin-verse" mid="v19119098">
			</marker>
			<v n="98">for it is ever with me.</v>
			<marker class="begin-verse" mid="v19119099">
			</marker>
			<v n="99">your testimonies are my meditation.</v>
			<marker class="begin-verse" mid="v19119100">
			</marker>
			<v n="100">keep your precepts.</v>
			<marker class="begin-verse" mid="v19119101">
			</marker>
			<v n="101">in order to keep your word.</v>
			<marker class="begin-verse" mid="v19119102">
			</marker>
			<v n="102">for you have taught me.</v>
			<marker class="begin-verse" mid="v19119103">
			</marker>
			<v n="103">sweeter than honey to my mouth!</v>
			<marker class="begin-verse" mid="v19119104">
			</marker>
			<v n="104">I hate every false way.</v>
			<marker class="begin-verse" mid="v19119105">
			</marker>
			<v n="105">and a light to my path.</v>
			<marker class="begin-verse" mid="v19119106">
			</marker>
			<v n="106">righteous rules.</v>
			<marker class="begin-verse" mid="v19119107">
			</marker>
			<v n="107">give me life, O Lord , according to your word!</v>
			<marker class="begin-verse" mid="v19119108">
			</marker>
			<v n="108">teach me your rules.</v>
			<marker class="begin-verse" mid="v19119109">
			</marker>
			<v n="109">forget your law.</v>
			<marker class="begin-verse" mid="v19119110">
			</marker>
			<v n="110">I do not stray from your precepts.</v>
			<marker class="begin-verse" mid="v19119111">
			</marker>
			<v n="111">the joy of my heart.</v>
			<marker class="begin-verse" mid="v19119112">
			</marker>
			<v n="112">to the end.</v>
			<marker class="begin-verse" mid="v19119113">
			</marker>
			<v n="113">your law.</v>
			<marker class="begin-verse" mid="v19119114">
			</marker>
			<v n="114">hope in your word.</v>
			<marker class="begin-verse" mid="v19119115">
			</marker>
			<v n="115">keep the commandments of my God.</v>
			<marker class="begin-verse" mid="v19119116">
			</marker>
			<v n="116">hope!</v>
			<marker class="begin-verse" mid="v19119117">
			</marker>
			<v n="117">and have regard for your statutes continually!</v>
			<marker class="begin-verse" mid="v19119118">
			</marker>
			<v n="118">for their cunning is in vain.</v>
			<marker class="begin-verse" mid="v19119119">
			</marker>
			<v n="119">I love your testimonies.</v>
			<marker class="begin-verse" mid="v19119120">
			</marker>
			<v n="120">and I am afraid of your judgments.</v>
			<marker class="begin-verse" mid="v19119121">
			</marker>
			<v n="121">do not leave me to my oppressors.</v>
			<marker class="begin-verse" mid="v19119122">
			</marker>
			<v n="122">the insolent oppress me.</v>
			<marker class="begin-verse" mid="v19119123">
			</marker>
			<v n="123">and for the fulfillment of your righteous promise.</v>
			<marker class="begin-verse" mid="v19119124">
			</marker>
			<v n="124">teach me your statutes.</v>
			<marker class="begin-verse" mid="v19119125">
			</marker>
			<v n="125">that I may know your testimonies!</v>
			<marker class="begin-verse" mid="v19119126">
			</marker>
			<v n="126">for your law has been broken.</v>
			<marker class="begin-verse" mid="v19119127">
			</marker>
