			<begin-paragraph>
			</begin-paragraph>
			<v n="1">May<crossref let="m" cid="c19020001.2" />the name of the God of Jacob<crossref let="n" cid="c19020001.3" />protect you!</v>
			<marker class="begin-verse" mid="v19020002">
			</marker>
			<v n="2">and give you support from<crossref let="p" cid="c19020002.2" />Zion!</v>
			<marker class="begin-verse" mid="v19020003">
			</marker>
			<v n="3">and regard with favor your burnt sacrifices! Selah</v>
			<marker class="begin-verse" mid="v19020004">
			</marker>
			<v n="4">and fulfill all your plans!</v>
			<marker class="begin-verse" mid="v19020005">
			</marker>
			<v n="5">May the Lord fulfill all your petitions!</v>
			<marker class="begin-verse" mid="v19020006">
			</marker>
