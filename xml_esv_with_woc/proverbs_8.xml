		<chapter num="8">
			<heading>
				Proverbs 8
			</heading>
			<heading>
				The Blessings of Wisdom
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">understanding raise her voice?</v>
			<marker class="begin-verse" mid="v20008002">
			</marker>
			<v n="2">at the crossroads she takes her stand;</v>
			<marker class="begin-verse" mid="v20008003">
			</marker>
			<v n="3">at the entrance of the portals she cries aloud:</v>
			<marker class="begin-verse" mid="v20008004">
			</marker>
			<v n="4">the children of man.</v>
			<marker class="begin-verse" mid="v20008005">
			</marker>
			<v n="5">fools, learn sense.</v>
			<marker class="begin-verse" mid="v20008006">
			</marker>
			<v n="6">what is right,</v>
			<marker class="begin-verse" mid="v20008007">
			</marker>
			<v n="7">wickedness is an abomination to my lips.</v>
			<marker class="begin-verse" mid="v20008008">
			</marker>
			<v n="8">twisted or crooked in them.</v>
			<marker class="begin-verse" mid="v20008009">
			</marker>
			<v n="9">and right to those who find knowledge.</v>
			<marker class="begin-verse" mid="v20008010">
			</marker>
			<v n="10">and knowledge rather than choice gold,</v>
			<marker class="begin-verse" mid="v20008011">
			</marker>
			<v n="11">all that you may desire cannot compare with her.</v>
			<marker class="begin-verse" mid="v20008012">
			</marker>
			<v n="12">discretion.</v>
			<marker class="begin-verse" mid="v20008013">
			</marker>
			<v n="13">perverted speech I hate.</v>
			<marker class="begin-verse" mid="v20008014">
			</marker>
			<v n="14">I have strength.</v>
			<marker class="begin-verse" mid="v20008015">
			</marker>
			<v n="15">and rulers decree what is just;</v>
			<marker class="begin-verse" mid="v20008016">
			</marker>
			<v n="16">and nobles, all who govern justly.</v>
			<marker class="begin-verse" mid="v20008017">
			</marker>
			<v n="17">those who seek me diligently find me.</v>
			<marker class="begin-verse" mid="v20008018">
			</marker>
			<v n="18">righteousness.</v>
			<marker class="begin-verse" mid="v20008019">
			</marker>
			<v n="19">choice silver.</v>
			<marker class="begin-verse" mid="v20008020">
			</marker>
			<v n="20">in the paths of justice,</v>
			<marker class="begin-verse" mid="v20008021">
			</marker>
			<v n="21">and filling their treasuries.</v>
			<marker class="begin-verse" mid="v20008022">
			</marker>
			<v n="22">of old.</v>
			<marker class="begin-verse" mid="v20008023">
			</marker>
			<v n="23">before the beginning of the earth.</v>
			<marker class="begin-verse" mid="v20008024">
			</marker>
			<v n="24">when there were no springs abounding with water.</v>
			<marker class="begin-verse" mid="v20008025">
			</marker>
			<v n="25">before the hills, I was brought forth,</v>
			<marker class="begin-verse" mid="v20008026">
			</marker>
			<v n="26">or the first of the dust of the world.</v>
			<marker class="begin-verse" mid="v20008027">
			</marker>
			<v n="27">a circle on the face of the deep,</v>
			<marker class="begin-verse" mid="v20008028">
			</marker>
			<v n="28">when he established the fountains of the deep,</v>
			<marker class="begin-verse" mid="v20008029">
			</marker>
			<v n="29">the foundations of the earth,</v>
			<marker class="begin-verse" mid="v20008030">
			</marker>
			<v n="30">rejoicing before him always,</v>
			<marker class="begin-verse" mid="v20008031">
			</marker>
			<v n="31">and delighting in the children of man.</v>
			<marker class="begin-verse" mid="v20008032">
			</marker>
			<v n="32">blessed are those who keep my ways.</v>
			<marker class="begin-verse" mid="v20008033">
			</marker>
			<v n="33">and do not neglect it.</v>
			<marker class="begin-verse" mid="v20008034">
			</marker>
			<v n="34">waiting beside my doors.</v>
			<marker class="begin-verse" mid="v20008035">
			</marker>
			<v n="35">obtains favor from the Lord ,</v>
			<marker class="begin-verse" mid="v20008036">
			</marker>
			<v n="36">love death.”</v>
			<marker class="begin-verse" mid="v20008037">
			</marker>
			<end-paragraph>
