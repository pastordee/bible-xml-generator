		<chapter num="15">
			<heading>
				Proverbs 15
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">but<crossref let="e" cid="c20015001.2" />a harsh word stirs up anger .</v>
			<marker class="begin-verse" mid="v20015002">
			</marker>
			<v n="2">but<crossref let="f" cid="c20015002.1" />the mouths of fools pour out folly .</v>
			<marker class="begin-verse" mid="v20015003">
			</marker>
			<v n="3">keeping watch on the evil and the good .</v>
			<marker class="begin-verse" mid="v20015004">
			</marker>
			<v n="4">but<crossref let="j" cid="c20015004.3" />perverseness in it breaks the spirit .</v>
			<marker class="begin-verse" mid="v20015005">
			</marker>
			<v n="5">but<crossref let="m" cid="c20015005.3" />whoever heeds reproof is prudent .</v>
			<marker class="begin-verse" mid="v20015006">
			</marker>
			<v n="6">but trouble befalls the income of the wicked .</v>
			<marker class="begin-verse" mid="v20015007">
			</marker>
			<v n="7">
				<crossref let="n" cid="c20015007.1" />not so the hearts of fools .</v>
			<marker class="begin-verse" mid="v20015008">
			</marker>
			<v n="8">but<crossref let="p" cid="c20015008.2" />the prayer of the upright is acceptable to him .</v>
			<marker class="begin-verse" mid="v20015009">
			</marker>
			<v n="9">but he loves him<crossref let="q" cid="c20015009.1" />who pursues righteousness .</v>
			<marker class="begin-verse" mid="v20015010">
			</marker>
			<v n="10">
				<crossref let="s" cid="c20015010.2" />whoever hates reproof will die .</v>
			<marker class="begin-verse" mid="v20015011">
			</marker>
			<v n="11">how much more<crossref let="t" cid="c20015011.1" />the hearts of the children of man !</v>
			<marker class="begin-verse" mid="v20015012">
			</marker>
			<v n="12">he will not go to the wise .</v>
			<marker class="begin-verse" mid="v20015013">
			</marker>
			<v n="13">but by<crossref let="x" cid="c20015013.2" />sorrow of heart the spirit is<crossref let="y" cid="c20015013.3" />crushed .</v>
			<marker class="begin-verse" mid="v20015014">
			</marker>
			<v n="14">but the mouths of fools feed on folly .</v>
			<marker class="begin-verse" mid="v20015015">
			</marker>
			<v n="15">but<crossref let="a" cid="c20015015.1" />the cheerful of heart has a continual feast .</v>
			<marker class="begin-verse" mid="v20015016">
			</marker>
			<v n="16">than great treasure and trouble with it .</v>
			<marker class="begin-verse" mid="v20015017">
			</marker>
			<v n="17">than<crossref let="d" cid="c20015017.2" />a fattened ox and hatred with it .</v>
			<marker class="begin-verse" mid="v20015018">
			</marker>
			<v n="18">but he who is<crossref let="g" cid="c20015018.3" />slow to anger quiets contention .</v>
			<marker class="begin-verse" mid="v20015019">
			</marker>
			<v n="19">but the path of the upright is<crossref let="j" cid="c20015019.3" />a level highway .</v>
			<marker class="begin-verse" mid="v20015020">
			</marker>
			<v n="20">but a foolish man despises his mother .</v>
			<marker class="begin-verse" mid="v20015021">
			</marker>
			<v n="21">but a man of understanding<crossref let="m" cid="c20015021.2" />walks straight ahead .</v>
			<marker class="begin-verse" mid="v20015022">
			</marker>
			<v n="22">but with many advisers they succeed .</v>
			<marker class="begin-verse" mid="v20015023">
			</marker>
			<v n="23">and<crossref let="o" cid="c20015023.1" />a word in season , how good it is !</v>
			<marker class="begin-verse" mid="v20015024">
			</marker>
			<v n="24">that he may turn away from Sheol beneath .</v>
			<marker class="begin-verse" mid="v20015025">
			</marker>
			<v n="25">but<crossref let="r" cid="c20015025.2" />maintains<crossref let="s" cid="c20015025.3" />the widow’s boundaries .</v>
			<marker class="begin-verse" mid="v20015026">
			</marker>
			<v n="26">but<crossref let="u" cid="c20015026.2" />gracious words are pure .</v>
			<marker class="begin-verse" mid="v20015027">
			</marker>
			<v n="27">but he who hates<crossref let="x" cid="c20015027.3" />bribes will live .</v>
			<marker class="begin-verse" mid="v20015028">
			</marker>
			<v n="28">but<crossref let="z" cid="c20015028.2" />the mouth of the wicked pours out evil things .</v>
			<marker class="begin-verse" mid="v20015029">
			</marker>
			<v n="29">but he<crossref let="b" cid="c20015029.2" />hears the prayer of the righteous .</v>
			<marker class="begin-verse" mid="v20015030">
			</marker>
			<v n="30">and<crossref let="d" cid="c20015030.2" />good news refreshes the bones .</v>
			<marker class="begin-verse" mid="v20015031">
			</marker>
			<v n="31">will dwell among the wise .</v>
			<marker class="begin-verse" mid="v20015032">
			</marker>
			<v n="32">but he who listens to reproof<crossref let="i" cid="c20015032.3" />gains intelligence .</v>
			<marker class="begin-verse" mid="v20015033">
			</marker>
			<v n="33">and<crossref let="k" cid="c20015033.2" />humility comes before honor .</v>
			<marker class="begin-verse" mid="v20015034">
			</marker>
			<end-paragraph>
			</end-paragraph>
			<footnotes>
				<footnotes-heading>Footnotes</footnotes-heading>
				<footnote id="1">15:4 Or *healing*</footnote>
				<footnote id="2">15:7 Or *the hearts of fools are not steadfast*</footnote>
				<footnote id="3">15:30 Hebrew *makes fat*</footnote>
			</footnotes>
		</chapter>
