		<chapter num="139">
			<heading>
				Psalm 139
			</heading>
			<heading>
				Search Me, O God, and Know My Heart
			</heading>
			<heading>
				To the choirmaster. A Psalm of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">searched me and known me!</v>
			<marker class="begin-verse" mid="v19139002">
			</marker>
			<v n="2">discern my thoughts from afar.</v>
			<marker class="begin-verse" mid="v19139003">
			</marker>
			<v n="3">and are acquainted with all my ways.</v>
			<marker class="begin-verse" mid="v19139004">
			</marker>
			<v n="4">you know it altogether.</v>
			<marker class="begin-verse" mid="v19139005">
			</marker>
			<v n="5">lay your hand upon me.</v>
			<marker class="begin-verse" mid="v19139006">
			</marker>
			<v n="6">it is high; I cannot attain it.</v>
			<marker class="begin-verse" mid="v19139007">
			</marker>
			<v n="7">shall I flee from your presence?</v>
			<marker class="begin-verse" mid="v19139008">
			</marker>
			<v n="8">If I make my bed in Sheol, you are there!</v>
			<marker class="begin-verse" mid="v19139009">
			</marker>
			<v n="9">and dwell in the uttermost parts of the sea,</v>
			<marker class="begin-verse" mid="v19139010">
			</marker>
			<v n="10">and your right hand shall hold me.</v>
			<marker class="begin-verse" mid="v19139011">
			</marker>
			<v n="11">and the light about me be night,”</v>
			<marker class="begin-verse" mid="v19139012">
			</marker>
			<v n="12">for darkness is as light with you.</v>
			<marker class="begin-verse" mid="v19139013">
			</marker>
			<v n="13">knitted me together in my mother's womb.</v>
			<marker class="begin-verse" mid="v19139014">
			</marker>
			<v n="14">my soul knows it very well.</v>
			<marker class="begin-verse" mid="v19139015">
			</marker>
			<v n="15">the depths of the earth.</v>
			<marker class="begin-verse" mid="v19139016">
			</marker>
			<v n="16">when as yet there was none of them.</v>
			<marker class="begin-verse" mid="v19139017">
			</marker>
			<v n="17">How vast is the sum of them!</v>
			<marker class="begin-verse" mid="v19139018">
			</marker>
			<v n="18">I awake, and I am still with you.</v>
			<marker class="begin-verse" mid="v19139019">
			</marker>
			<v n="19">depart from me!</v>
			<marker class="begin-verse" mid="v19139020">
			</marker>
			<v n="20">take your name in vain.</v>
			<marker class="begin-verse" mid="v19139021">
			</marker>
			<v n="21">rise up against you?</v>
			<marker class="begin-verse" mid="v19139022">
			</marker>
			<v n="22">I count them my enemies.</v>
			<marker class="begin-verse" mid="v19139023">
			</marker>
			<v n="23">Try me and know my thoughts!</v>
			<marker class="begin-verse" mid="v19139024">
			</marker>
			<v n="24">the way everlasting!</v>
			<marker class="begin-verse" mid="v19139025">
			</marker>
			<end-paragraph>
			</end-paragraph>
