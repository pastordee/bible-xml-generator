				<note nid="n19104030.30">
				</note>
			</v>
			<marker class="begin-verse" mid="v19104031">
			</marker>
			<v n="31">
				May the 
				<crossref let="j" cid="c19104031.61">
				</crossref>
				glory of, 
				<crossref let="k" cid="c19104031.62">
				</crossref>
				the LORD endure forever; may the LORD rejoice in his works,
			</v>
			<marker class="begin-verse" mid="v19104032">
			</marker>
			<v n="32">
				who looks 
				<crossref let="l" cid="c19104032.63">
				</crossref>
				on the, 
				<crossref let="m" cid="c19104032.64">
				</crossref>
				earth and it trembles, who touches the mountains and they smoke!
			</v>
			<marker class="begin-verse" mid="v19104033">
			</marker>
			<v n="33">
				I will 
				<crossref let="n" cid="c19104033.65">
				</crossref>
				sing to, 
				<crossref let="o" cid="c19104033.66">
				</crossref>
