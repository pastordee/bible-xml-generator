			<heading>
				Psalm 10
			</heading>
			<heading>
				Why Do You Hide Yourself?
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">Why<crossref let="l" cid="c19010001.2" />do you hide yourself in<crossref let="m" cid="c19010001.3" />times of trouble ?</v>
			<marker class="begin-verse" mid="v19010002">
			</marker>
			<v n="2">let them<crossref let="n" cid="c19010002.1" />be caught in the schemes that they have devised .</v>
			<marker class="begin-verse" mid="v19010003">
			</marker>
			<v n="3">and the one greedy for gain<crossref let="p" cid="c19010003.2" />curses and<crossref let="q" cid="c19010003.3" />renounces the Lord .</v>
			<marker class="begin-verse" mid="v19010004">
			</marker>
			<v n="4">all his thoughts are ,<crossref let="r" cid="c19010004.2" />“ There is no God . ”</v>
			<marker class="begin-verse" mid="v19010005">
			</marker>
			<v n="5">as for all his foes , he<crossref let="t" cid="c19010005.2" />puffs at them .</v>
			<marker class="begin-verse" mid="v19010006">
			</marker>
			<v n="6">throughout all generations I<crossref let="v" cid="c19010006.2" />shall not meet adversity . ”</v>
			<marker class="begin-verse" mid="v19010007">
			</marker>
			<v n="7">
				<crossref let="z" cid="c19010007.6" />under his tongue are<crossref let="a" cid="c19010007.1" />mischief and<crossref let="b" cid="c19010007.2" />iniquity .</v>
			<marker class="begin-verse" mid="v19010008">
			</marker>
			<v n="8">His eyes stealthily watch for the helpless ;</v>
			<marker class="begin-verse" mid="v19010009">
			</marker>
			<v n="9">he seizes the poor when he draws him into his<crossref let="g" cid="c19010009.4" />net .</v>
			<marker class="begin-verse" mid="v19010010">
			</marker>
			<v n="10">and fall by his might .</v>
			<marker class="begin-verse" mid="v19010011">
			</marker>
			<v n="11">he has<crossref let="h" cid="c19010011.1" />hidden his face , he<crossref let="i" cid="c19010011.2" />will never see it . ”</v>
			<marker class="begin-verse" mid="v19010012">
			</marker>
			<v n="12">
				<crossref let="l" cid="c19010012.3" />forget not the afflicted .</v>
			<marker class="begin-verse" mid="v19010013">
			</marker>
			<v n="13">and say in his heart , “ You will not<crossref let="n" cid="c19010013.2" />call to account ” ?</v>
			<marker class="begin-verse" mid="v19010014">
			</marker>
			<v n="14">you have been<crossref let="q" cid="c19010014.3" />the helper of the fatherless .</v>
			<marker class="begin-verse" mid="v19010015">
			</marker>
			<v n="15">
				<crossref let="s" cid="c19010015.2" />call his wickedness to account till you find none .</v>
			<marker class="begin-verse" mid="v19010016">
			</marker>
			<v n="16">the<crossref let="u" cid="c19010016.2" />nations perish from his land .</v>
			<marker class="begin-verse" mid="v19010017">
			</marker>
			<v n="17">you will<crossref let="v" cid="c19010017.1" />strengthen their heart ; you will incline your ear</v>
			<marker class="begin-verse" mid="v19010018">
			</marker>
			<v n="18">so that<crossref let="y" cid="c19010018.3" />man who is of the earth may strike terror no more .</v>
			<marker class="begin-verse" mid="v19010019">
			</marker>
			<end-paragraph>
			</end-paragraph>
