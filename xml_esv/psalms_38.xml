			<marker class="begin-verse" mid="v19038022">
			</marker>
			<v n="22">
				Make haste 
				<crossref let="r" cid="c19038022.43">
				</crossref>
				to help, 
				<crossref let="s" cid="c19038022.44">
				</crossref>
