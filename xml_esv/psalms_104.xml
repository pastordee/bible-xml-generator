			</v>
			<marker class="begin-verse" mid="v19104005">
			</marker>
			<v n="5">
				He set 
				<crossref let="j" cid="c19104005.9">
				</crossref>
				the earth, 
				<crossref let="k" cid="c19104005.10">
				</crossref>
				on its foundations, so that it should never be moved.
			</v>
			<marker class="begin-verse" mid="v19104006">
			</marker>
			<v n="6">
				You covered 
				<crossref let="l" cid="c19104006.11">
				</crossref>
				it with, 
				<crossref let="m" cid="c19104006.12">
				</crossref>
