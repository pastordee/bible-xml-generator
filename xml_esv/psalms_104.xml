			</v>
			<marker class="begin-verse" mid="v19104002">
			</marker>
			<v n="2">
				covering yourself 
				<crossref let="d" cid="c19104002.3">
				</crossref>
				with light, 
				<crossref let="e" cid="c19104002.4">
				</crossref>
				as with a garment, stretching out the heavens like a tent.
			</v>
			<marker class="begin-verse" mid="v19104003">
			</marker>
			<v n="3">
				He lays 
				<crossref let="f" cid="c19104003.5">
				</crossref>
				the beams, 
				<crossref let="g" cid="c19104003.6">
				</crossref>
