			</v>
			<marker class="begin-verse" mid="v18038002">
			</marker>
			<v n="2">
				“Who is 
				<crossref let="d" cid="c18038002.3">
				</crossref>
				this that, 
				<crossref let="e" cid="c18038002.4">
				</crossref>
				darkens counsel by words without knowledge?
			</v>
			<marker class="begin-verse" mid="v18038003">
			</marker>
			<v n="3">
				Dress for 
				<crossref let="f" cid="c18038003.5">
				</crossref>
