				<note nid="n18020009.9">
				</note>
			</v>
			<marker class="begin-verse" mid="v18020010">
			</marker>
			<v n="10">
				His children 
				<crossref let="t" cid="c18020010.19">
				</crossref>
				will seek, 
				<crossref let="u" cid="c18020010.20">
				</crossref>
