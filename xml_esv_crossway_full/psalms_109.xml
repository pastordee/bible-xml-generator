				<footnote id="2">109:17 Revocalization; Masoretic Text *curses have come*</footnote>
				<footnote id="3">109:17 Revocalization; Masoretic Text *it is far*</footnote>
				<footnote id="4">109:18 Revocalization; Masoretic Text *it has soaked*</footnote>
			</footnotes>
