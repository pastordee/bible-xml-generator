		<chapter num="19">
			<heading>
				Proverbs 19
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">than one who is crooked in speech and is a fool .</v>
			<marker class="begin-verse" mid="v20019002">
			</marker>
			<v n="2">and whoever<crossref let="c" cid="c20019002.1" />makes haste with his feet misses his way .</v>
			<marker class="begin-verse" mid="v20019003">
			</marker>
			<v n="3">his heart<crossref let="e" cid="c20019003.2" />rages against the Lord .</v>
			<marker class="begin-verse" mid="v20019004">
			</marker>
			<v n="4">
				<crossref let="f" cid="c20019004.1" />but a poor man is deserted by his friend .</v>
			<marker class="begin-verse" mid="v20019005">
			</marker>
			<v n="5">and he who<crossref let="h" cid="c20019005.2" />breathes out lies will not escape .</v>
			<marker class="begin-verse" mid="v20019006">
			</marker>
			<v n="6">and everyone is a friend to a man who gives<crossref let="i" cid="c20019006.1" />gifts .</v>
			<marker class="begin-verse" mid="v20019007">
			</marker>
			<v n="7">He pursues them with words , but does not have them .</v>
			<marker class="begin-verse" mid="v20019008">
			</marker>
			<v n="8">he who keeps understanding will<crossref let="m" cid="c20019008.2" />discover good .</v>
			<marker class="begin-verse" mid="v20019009">
			</marker>
			<v n="9">and he who<crossref let="h" cid="c20019009.2" />breathes out lies will perish .</v>
			<marker class="begin-verse" mid="v20019010">
			</marker>
			<v n="10">much less for<crossref let="o" cid="c20019010.2" />a slave to rule over princes .</v>
			<marker class="begin-verse" mid="v20019011">
			</marker>
			<v n="11">and it is his glory to overlook an offense .</v>
			<marker class="begin-verse" mid="v20019012">
			</marker>
			<v n="12">but his<crossref let="r" cid="c20019012.2" />favor is like<crossref let="s" cid="c20019012.3" />dew on the grass .</v>
			<marker class="begin-verse" mid="v20019013">
			</marker>
			<v n="13">and<crossref let="u" cid="c20019013.2" />a wife’s quarreling is<crossref let="v" cid="c20019013.3" />a continual dripping of rain .</v>
			<marker class="begin-verse" mid="v20019014">
			</marker>
			<v n="14">but a prudent wife is<crossref let="x" cid="c20019014.2" />from the Lord .</v>
			<marker class="begin-verse" mid="v20019015">
			</marker>
			<v n="15">and<crossref let="a" cid="c20019015.1" />an idle person will suffer hunger .</v>
			<marker class="begin-verse" mid="v20019016">
			</marker>
			<v n="16">he who despises his ways will die .</v>
			<marker class="begin-verse" mid="v20019017">
			</marker>
			<v n="17">and he<crossref let="d" cid="c20019017.2" />will repay him for his<crossref let="e" cid="c20019017.3" />deed .</v>
			<marker class="begin-verse" mid="v20019018">
			</marker>
			<v n="18">do not set your heart on<crossref let="g" cid="c20019018.2" />putting him to death .</v>
			<marker class="begin-verse" mid="v20019019">
			</marker>
			<v n="19">for if you deliver him , you will only have to do it again .</v>
			<marker class="begin-verse" mid="v20019020">
			</marker>
			<v n="20">that you may gain wisdom in<crossref let="h" cid="c20019020.1" />the future .</v>
			<marker class="begin-verse" mid="v20019021">
			</marker>
			<v n="21">but<crossref let="j" cid="c20019021.2" />it is the purpose of the Lord<crossref let="k" cid="c20019021.3" />that will stand .</v>
			<marker class="begin-verse" mid="v20019022">
			</marker>
			<v n="22">and a poor man is better than a liar .</v>
			<marker class="begin-verse" mid="v20019023">
			</marker>
			<v n="23">he will<crossref let="n" cid="c20019023.3" />not be visited by harm .</v>
			<marker class="begin-verse" mid="v20019024">
			</marker>
			<v n="24">and will not even bring it back to his mouth .</v>
			<marker class="begin-verse" mid="v20019025">
			</marker>
			<v n="25">
				<crossref let="t" cid="c20019025.4" />reprove a man of understanding , and he will gain knowledge .</v>
			<marker class="begin-verse" mid="v20019026">
			</marker>
			<v n="26">is<crossref let="u" cid="c20019026.1" />a son who brings shame and reproach .</v>
			<marker class="begin-verse" mid="v20019027">
			</marker>
			<v n="27">
				<crossref let="v" cid="c20019027.1" />and you will stray from the words of knowledge .</v>
			<marker class="begin-verse" mid="v20019028">
			</marker>
			<v n="28">and the mouth of the wicked<crossref let="w" cid="c20019028.1" />devours iniquity .</v>
			<marker class="begin-verse" mid="v20019029">
			</marker>
			<v n="29">and<crossref let="x" cid="c20019029.2" />beating for the backs of fools .</v>
			<marker class="begin-verse" mid="v20019030">
			</marker>
			<end-paragraph>
			</end-paragraph>
