				<note nid="n18020018.18">
				</note>
			</v>
			<marker class="begin-verse" mid="v18020019">
			</marker>
			<v n="19">
				For he 
				<crossref let="l" cid="c18020019.37">
				</crossref>
				has crushed, 
				<crossref let="m" cid="c18020019.38">
				</crossref>
