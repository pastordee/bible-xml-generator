			<marker class="begin-verse" mid="v19119167">
			</marker>
			<v n="167">love them exceedingly.</v>
			<marker class="begin-verse" mid="v19119168">
			</marker>
			<v n="168">for all my ways are before you.</v>
			<marker class="begin-verse" mid="v19119169">
			</marker>
