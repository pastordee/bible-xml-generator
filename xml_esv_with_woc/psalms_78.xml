				<footnote id="2">78:9 Hebrew *armed and shooting*</footnote>
				<footnote id="3">78:33 Hebrew *in*</footnote>
				<footnote id="4">78:33 Or *vapor*</footnote>
				<footnote id="5">78:42 Hebrew *hand*</footnote>
