			<heading>
				Job Replies: Miserable Comforters Are You
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">Then Job answered and said :</v>
			<marker class="begin-verse" mid="v18016002">
			</marker>
			<v n="2">
				<crossref let="f" cid="c18016002.2" />miserable comforters are you all .</v>
			<marker class="begin-verse" mid="v18016003">
			</marker>
			<v n="3">Or what provokes you that you answer ?</v>
			<marker class="begin-verse" mid="v18016004">
			</marker>
			<v n="4">and<crossref let="h" cid="c18016004.1" />shake my head at you .</v>
			<marker class="begin-verse" mid="v18016005">
			</marker>
			<v n="5">and the solace of my lips would assuage your pain .</v>
			<marker class="begin-verse" mid="v18016006">
			</marker>
			<v n="6">and if I forbear , how much of it leaves me ?</v>
			<marker class="begin-verse" mid="v18016007">
			</marker>
			<v n="7">
				<crossref let="i" cid="c18016007.1" />he has made desolate all my company .</v>
			<marker class="begin-verse" mid="v18016008">
			</marker>
			<v n="8">it testifies to my face .</v>
			<marker class="begin-verse" mid="v18016009">
			</marker>
			<v n="9">my adversary sharpens his eyes against me .</v>
			<marker class="begin-verse" mid="v18016010">
			</marker>
			<v n="10">they<crossref let="q" cid="c18016010.3" />mass themselves together against me .</v>
			<marker class="begin-verse" mid="v18016011">
			</marker>
			<v n="11">and casts me into the hands of the wicked .</v>
			<marker class="begin-verse" mid="v18016012">
			</marker>
			<v n="12">he set me up as his<crossref let="r" cid="c18016012.1" />target ;</v>
			<marker class="begin-verse" mid="v18016013">
			</marker>
			<v n="13">he<crossref let="u" cid="c18016013.3" />pours out my gall on the ground .</v>
			<marker class="begin-verse" mid="v18016014">
			</marker>
			<v n="14">he<crossref let="w" cid="c18016014.2" />runs upon me like a warrior .</v>
			<marker class="begin-verse" mid="v18016015">
			</marker>
			<v n="15">and have laid<crossref let="y" cid="c18016015.2" />my strength<crossref let="z" cid="c18016015.3" />in the dust .</v>
			<marker class="begin-verse" mid="v18016016">
			</marker>
			<v n="16">and on my eyelids is<crossref let="a" cid="c18016016.1" />deep darkness ,</v>
			<marker class="begin-verse" mid="v18016017">
			</marker>
			<v n="17">and my prayer is pure .</v>
			<marker class="begin-verse" mid="v18016018">
			</marker>
			<v n="18">and let my<crossref let="d" cid="c18016018.2" />cry find no resting place .</v>
			<marker class="begin-verse" mid="v18016019">
			</marker>
			<v n="19">and he who testifies for me is<crossref let="f" cid="c18016019.2" />on high .</v>
			<marker class="begin-verse" mid="v18016020">
			</marker>
			<v n="20">my eye pours out tears to God ,</v>
			<marker class="begin-verse" mid="v18016021">
			</marker>
			<v n="21">as a son of man does with his neighbor .</v>
			<marker class="begin-verse" mid="v18016022">
			</marker>
			<v n="22">I shall go the way<crossref let="i" cid="c18016022.1" />from which I shall not return .</v>
			<marker class="begin-verse" mid="v18016023">
			</marker>
