			</v>
			<marker class="begin-verse" mid="v18033005">
			</marker>
			<v n="5">
				Answer me, 
				<crossref let="j" cid="c18033005.9">
				</crossref>
				if you, 
				<crossref let="k" cid="c18033005.10">
				</crossref>
				can; set your words in order before me; take your stand.
			</v>
			<marker class="begin-verse" mid="v18033006">
			</marker>
			<v n="6">
				Behold, I 
				<crossref let="l" cid="c18033006.11">
				</crossref>
				am toward, 
				<crossref let="m" cid="c18033006.12">
				</crossref>
