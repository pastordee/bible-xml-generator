				<crossref let="d" cid="c18020002.3">
				</crossref>
				thoughts answer, 
				<crossref let="e" cid="c18020002.4">
				</crossref>
				me, because of my haste within me.
			</v>
			<marker class="begin-verse" mid="v18020003">
			</marker>
