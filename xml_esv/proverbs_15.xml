			</v>
			<marker class="begin-verse" mid="v20015030">
			</marker>
			<v n="30">
				The light 
				<crossref let="h" cid="c20015030.59">
				</crossref>
				of the, 
				<crossref let="i" cid="c20015030.60">
				</crossref>
