				<note nid="n19038009.9">
				</note>
			</v>
			<marker class="begin-verse" mid="v19038010">
			</marker>
			<v n="10">
				My heart 
				<crossref let="t" cid="c19038010.19">
				</crossref>
				throbs; my, 
				<crossref let="u" cid="c19038010.20">
				</crossref>
