			<begin-paragraph>
			</begin-paragraph>
			<v n="1">and whoever<crossref let="a" cid="c20020001.1" />is led astray by it is not wise .</v>
			<marker class="begin-verse" mid="v20020002">
			</marker>
			<v n="2">whoever provokes him to anger<crossref let="c" cid="c20020002.2" />forfeits his life .</v>
			<marker class="begin-verse" mid="v20020003">
			</marker>
			<v n="3">but every fool will be quarreling .</v>
			<marker class="begin-verse" mid="v20020004">
			</marker>
			<v n="4">
				<crossref let="f" cid="c20020004.2" />he will seek at harvest and have nothing .</v>
			<marker class="begin-verse" mid="v20020005">
			</marker>
			<v n="5">but a man of understanding will draw it out .</v>
			<marker class="begin-verse" mid="v20020006">
			</marker>
			<v n="6">but<crossref let="i" cid="c20020006.2" />a faithful man who can find ?</v>
			<marker class="begin-verse" mid="v20020007">
			</marker>
			<v n="7">
				<crossref let="k" cid="c20020007.2" />blessed are his children after him !</v>
			<marker class="begin-verse" mid="v20020008">
			</marker>
			<v n="8">
				<crossref let="m" cid="c20020008.2" />winnows all evil with his eyes .</v>
			<marker class="begin-verse" mid="v20020009">
			</marker>
			<v n="9">I am clean from my sin ” ?</v>
			<marker class="begin-verse" mid="v20020010">
			</marker>
			<v n="10">are both alike an abomination to the Lord .</v>
			<marker class="begin-verse" mid="v20020011">
			</marker>
			<v n="11">by whether his conduct is pure and upright .</v>
			<marker class="begin-verse" mid="v20020012">
			</marker>
			<v n="12">
				<crossref let="r" cid="c20020012.2" />the Lord has made them both .</v>
			<marker class="begin-verse" mid="v20020013">
			</marker>
			<v n="13">open your eyes , and you will have<crossref let="u" cid="c20020013.3" />plenty of bread .</v>
			<marker class="begin-verse" mid="v20020014">
			</marker>
			<v n="14">but when he goes away , then he boasts .</v>
			<marker class="begin-verse" mid="v20020015">
			</marker>
			<v n="15">
				<crossref let="w" cid="c20020015.2" />but the lips of knowledge are a precious jewel .</v>
			<marker class="begin-verse" mid="v20020016">
			</marker>
			<v n="16">and<crossref let="y" cid="c20020016.2" />hold it in pledge when he puts up security for foreigners .</v>
			<marker class="begin-verse" mid="v20020017">
			</marker>
			<v n="17">but afterward his mouth will be full of<crossref let="a" cid="c20020017.1" />gravel .</v>
			<marker class="begin-verse" mid="v20020018">
			</marker>
			<v n="18">by<crossref let="c" cid="c20020018.2" />wise guidance<crossref let="d" cid="c20020018.3" />wage war .</v>
			<marker class="begin-verse" mid="v20020019">
			</marker>
			<v n="19">therefore do not associate with<crossref let="f" cid="c20020019.2" />a simple babbler .</v>
			<marker class="begin-verse" mid="v20020020">
			</marker>
			<v n="20">
				<crossref let="h" cid="c20020020.2" />his lamp will be put out in utter darkness .</v>
			<marker class="begin-verse" mid="v20020021">
			</marker>
			<v n="21">will not be blessed in the end .</v>
			<marker class="begin-verse" mid="v20020022">
			</marker>
			<v n="22">
				<crossref let="k" cid="c20020022.2" />wait for the Lord , and he will deliver you .</v>
			<marker class="begin-verse" mid="v20020023">
			</marker>
			<v n="23">and<crossref let="m" cid="c20020023.2" />false scales are not good .</v>
			<marker class="begin-verse" mid="v20020024">
			</marker>
