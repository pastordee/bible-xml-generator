			<begin-paragraph>
			</begin-paragraph>
			<v n="1">for<crossref let="k" cid="c19147001.3" />it is pleasant , and<crossref let="l" cid="c19147001.4" />a song of praise is fitting .</v>
			<marker class="begin-verse" mid="v19147002">
			</marker>
			<v n="2">he<crossref let="n" cid="c19147002.2" />gathers the outcasts of Israel .</v>
			<marker class="begin-verse" mid="v19147003">
			</marker>
			<v n="3">and<crossref let="p" cid="c19147003.2" />binds up their wounds .</v>
			<marker class="begin-verse" mid="v19147004">
			</marker>
			<v n="4">he<crossref let="r" cid="c19147004.2" />gives to all of them their names .</v>
			<marker class="begin-verse" mid="v19147005">
			</marker>
			<v n="5">
				<crossref let="u" cid="c19147005.3" />his understanding is beyond measure .</v>
			<marker class="begin-verse" mid="v19147006">
			</marker>
			<v n="6">he casts the wicked to the ground .</v>
			<marker class="begin-verse" mid="v19147007">
			</marker>
			<v n="7">make melody to our God on<crossref let="x" cid="c19147007.2" />the lyre !</v>
			<marker class="begin-verse" mid="v19147008">
			</marker>
