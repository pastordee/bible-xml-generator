			<heading>
				Proverbs 4
			</heading>
			<heading>
				A Father’s Wise Instruction
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">gain insight,</v>
			<marker class="begin-verse" mid="v20004002">
			</marker>
			<v n="2">do not forsake my teaching.</v>
			<marker class="begin-verse" mid="v20004003">
			</marker>
			<v n="3">the only one in the sight of my mother,</v>
			<marker class="begin-verse" mid="v20004004">
			</marker>
			<v n="4">keep my commandments, and live.</v>
			<marker class="begin-verse" mid="v20004005">
			</marker>
			<v n="5">do not forget, and do not turn away from the words of my mouth.</v>
			<marker class="begin-verse" mid="v20004006">
			</marker>
			<v n="6">love her, and she will guard you.</v>
			<marker class="begin-verse" mid="v20004007">
			</marker>
			<v n="7">insight.</v>
			<marker class="begin-verse" mid="v20004008">
			</marker>
			<v n="8">if you embrace her.</v>
			<marker class="begin-verse" mid="v20004009">
			</marker>
			<v n="9">she will bestow on you a beautiful crown.”</v>
			<marker class="begin-verse" mid="v20004010">
			</marker>
			<v n="10">the years of your life may be many.</v>
			<marker class="begin-verse" mid="v20004011">
			</marker>
			<v n="11">I have led you in the paths of uprightness.</v>
			<marker class="begin-verse" mid="v20004012">
			</marker>
			<v n="12">if you run, you will not stumble.</v>
			<marker class="begin-verse" mid="v20004013">
			</marker>
			<v n="13">life.</v>
			<marker class="begin-verse" mid="v20004014">
			</marker>
			<v n="14">and do not walk in the way of the evil.</v>
			<marker class="begin-verse" mid="v20004015">
			</marker>
			<v n="15">turn away from it and pass on.</v>
			<marker class="begin-verse" mid="v20004016">
			</marker>
			<v n="16">they are robbed of sleep unless they have made someone stumble.</v>
			<marker class="begin-verse" mid="v20004017">
			</marker>
			<v n="17">and drink the wine of violence.</v>
			<marker class="begin-verse" mid="v20004018">
			</marker>
			<v n="18">full day.</v>
			<marker class="begin-verse" mid="v20004019">
			</marker>
			<v n="19">stumble.</v>
			<marker class="begin-verse" mid="v20004020">
			</marker>
			<v n="20">incline your ear to my sayings.</v>
			<marker class="begin-verse" mid="v20004021">
			</marker>
			<v n="21">keep them within your heart.</v>
			<marker class="begin-verse" mid="v20004022">
			</marker>
			<v n="22">and healing to all their flesh.</v>
			<marker class="begin-verse" mid="v20004023">
			</marker>
			<v n="23">the springs of life.</v>
			<marker class="begin-verse" mid="v20004024">
			</marker>
			<v n="24">devious talk far from you.</v>
			<marker class="begin-verse" mid="v20004025">
			</marker>
			<v n="25">and your gaze be straight before you.</v>
			<marker class="begin-verse" mid="v20004026">
			</marker>
			<v n="26">then all your ways will be sure.</v>
			<marker class="begin-verse" mid="v20004027">
			</marker>
			<v n="27">turn your foot away from evil.</v>
			<marker class="begin-verse" mid="v20004028">
			</marker>
