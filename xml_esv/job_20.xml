				<note nid="n18020015.15">
				</note>
			</v>
			<marker class="begin-verse" mid="v18020016">
			</marker>
			<v n="16">
				He will 
				<crossref let="f" cid="c18020016.31">
				</crossref>
				suck the, 
				<crossref let="g" cid="c18020016.32">
				</crossref>
