			<marker class="begin-verse" mid="v19031004">
			</marker>
			<v n="4">refuge.</v>
			<marker class="begin-verse" mid="v19031005">
			</marker>
			<v n="5">faithful God.</v>
			<marker class="begin-verse" mid="v19031006">
			</marker>
			<v n="6">but I trust in the Lord .</v>
			<marker class="begin-verse" mid="v19031007">
			</marker>
