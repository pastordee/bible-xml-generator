			<marker class="begin-verse" mid="v23033024">
			</marker>
			<v n="24">
				<crossref let="u" cid="c23033024.2" />the people who dwell there will be forgiven their iniquity .</v>
			<marker class="begin-verse" mid="v23033025">
			</marker>
