			<marker class="begin-verse" mid="v19147016">
			</marker>
			<v n="16">he scatters<crossref let="l" cid="c19147016.2" />frost like ashes .</v>
			<marker class="begin-verse" mid="v19147017">
			</marker>
			<v n="17">who can stand before his<crossref let="n" cid="c19147017.2" />cold ?</v>
			<marker class="begin-verse" mid="v19147018">
			</marker>
