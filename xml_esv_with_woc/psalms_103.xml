		<chapter num="103">
			<heading>
				Psalm 103
			</heading>
			<heading>
				Bless the LORD, O My Soul
			</heading>
			<heading>
				Of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">bless his holy name!</v>
			<marker class="begin-verse" mid="v19103002">
			</marker>
			<v n="2">forget not all his benefits,</v>
			<marker class="begin-verse" mid="v19103003">
			</marker>
			<v n="3">heals all your diseases,</v>
			<marker class="begin-verse" mid="v19103004">
			</marker>
			<v n="4">crowns you with steadfast love and mercy,</v>
			<marker class="begin-verse" mid="v19103005">
			</marker>
			<v n="5">the eagle's.</v>
			<marker class="begin-verse" mid="v19103006">
			</marker>
			<v n="6">and justice for all who are oppressed.</v>
			<marker class="begin-verse" mid="v19103007">
			</marker>
			<v n="7">acts to the people of Israel.</v>
			<marker class="begin-verse" mid="v19103008">
			</marker>
			<v n="8">slow to anger and abounding in steadfast love.</v>
			<marker class="begin-verse" mid="v19103009">
			</marker>
			<v n="9">keep his anger forever.</v>
			<marker class="begin-verse" mid="v19103010">
			</marker>
			<v n="10">nor repay us according to our iniquities.</v>
			<marker class="begin-verse" mid="v19103011">
			</marker>
			<v n="11">those who fear him;</v>
			<marker class="begin-verse" mid="v19103012">
			</marker>
			<v n="12">remove our transgressions from us.</v>
			<marker class="begin-verse" mid="v19103013">
			</marker>
			<v n="13">to those who fear him.</v>
			<marker class="begin-verse" mid="v19103014">
			</marker>
			<v n="14">remembers that we are dust.</v>
			<marker class="begin-verse" mid="v19103015">
			</marker>
			<v n="15">a flower of the field;</v>
			<marker class="begin-verse" mid="v19103016">
			</marker>
			<v n="16">its place knows it no more.</v>
			<marker class="begin-verse" mid="v19103017">
			</marker>
			<v n="17">children's children,</v>
			<marker class="begin-verse" mid="v19103018">
			</marker>
			<v n="18">remember to do his commandments.</v>
			<marker class="begin-verse" mid="v19103019">
			</marker>
			<v n="19">kingdom rules over all.</v>
			<marker class="begin-verse" mid="v19103020">
			</marker>
			<v n="20">obeying the voice of his word!</v>
			<marker class="begin-verse" mid="v19103021">
			</marker>
			<v n="21">ministers, who do his will!</v>
			<marker class="begin-verse" mid="v19103022">
			</marker>
			<v n="22">Bless the Lord , O my soul!</v>
			<marker class="begin-verse" mid="v19103023">
			</marker>
			<end-paragraph>
			</end-paragraph>
