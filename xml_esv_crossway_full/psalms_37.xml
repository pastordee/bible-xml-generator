		<chapter num="37">
			<heading>
				Psalm 37
			</heading>
			<heading>
				He Will Not Forsake His Saints
			</heading>
			<heading>
				(1) Of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">be not<crossref let="v" cid="c19037001.2" />envious of wrongdoers !</v>
			<marker class="begin-verse" mid="v19037002">
			</marker>
			<v n="2">and wither<crossref let="y" cid="c19037002.3" />like the green herb .</v>
			<marker class="begin-verse" mid="v19037003">
			</marker>
			<v n="3">
				<crossref let="a" cid="c19037003.1" />dwell in the land and befriend faithfulness .</v>
			<marker class="begin-verse" mid="v19037004">
			</marker>
			<v n="4">and he will<crossref let="c" cid="c19037004.2" />give you the desires of your heart .</v>
			<marker class="begin-verse" mid="v19037005">
			</marker>
			<v n="5">
				<crossref let="z" cid="c19037005.2" />trust in him , and he will act .</v>
			<marker class="begin-verse" mid="v19037006">
			</marker>
			<v n="6">and your justice as<crossref let="f" cid="c19037006.2" />the noonday .</v>
			<marker class="begin-verse" mid="v19037007">
			</marker>
			<v n="7">over the man who carries out evil devices !</v>
			<marker class="begin-verse" mid="v19037008">
			</marker>
			<v n="8">
				<crossref let="h" cid="c19037008.1" />Fret not yourself ; it tends only to evil .</v>
			<marker class="begin-verse" mid="v19037009">
			</marker>
			<v n="9">but those who wait for the Lord shall<crossref let="l" cid="c19037009.2" />inherit the land .</v>
			<marker class="begin-verse" mid="v19037010">
			</marker>
			<v n="10">though you look carefully at<crossref let="n" cid="c19037010.2" />his place , he will not be there .</v>
			<marker class="begin-verse" mid="v19037011">
			</marker>
			<v n="11">and delight themselves in<crossref let="p" cid="c19037011.2" />abundant peace .</v>
			<marker class="begin-verse" mid="v19037012">
			</marker>
			<v n="12">and<crossref let="r" cid="c19037012.2" />gnashes his teeth at him ,</v>
			<marker class="begin-verse" mid="v19037013">
			</marker>
			<v n="13">for he sees that his<crossref let="t" cid="c19037013.2" />day is coming .</v>
			<marker class="begin-verse" mid="v19037014">
			</marker>
			<v n="14">to slay those whose<crossref let="v" cid="c19037014.2" />way is upright ;</v>
			<marker class="begin-verse" mid="v19037015">
			</marker>
			<v n="15">and their<crossref let="w" cid="c19037015.1" />bows shall be broken .</v>
			<marker class="begin-verse" mid="v19037016">
			</marker>
			<v n="16">than the abundance of many wicked .</v>
			<marker class="begin-verse" mid="v19037017">
			</marker>
			<v n="17">but the Lord<crossref let="z" cid="c19037017.2" />upholds the righteous .</v>
			<marker class="begin-verse" mid="v19037018">
			</marker>
			<v n="18">and their<crossref let="b" cid="c19037018.2" />heritage will remain forever ;</v>
			<marker class="begin-verse" mid="v19037019">
			</marker>
			<v n="19">in<crossref let="c" cid="c19037019.1" />the days of famine they have abundance .</v>
			<marker class="begin-verse" mid="v19037020">
			</marker>
			<v n="20">they vanish — like<crossref let="e" cid="c19037020.2" />smoke they vanish away .</v>
			<marker class="begin-verse" mid="v19037021">
			</marker>
			<v n="21">but the righteous<crossref let="f" cid="c19037021.1" />is generous and gives ;</v>
			<marker class="begin-verse" mid="v19037022">
			</marker>
			<v n="22">but those cursed by him<crossref let="h" cid="c19037022.2" />shall be cut off .</v>
			<marker class="begin-verse" mid="v19037023">
			</marker>
			<v n="23">when he delights in his way ;</v>
			<marker class="begin-verse" mid="v19037024">
			</marker>
			<v n="24">for the Lord<crossref let="l" cid="c19037024.2" />upholds his hand .</v>
			<marker class="begin-verse" mid="v19037025">
			</marker>
			<v n="25">or his children<crossref let="m" cid="c19037025.1" />begging for bread .</v>
			<marker class="begin-verse" mid="v19037026">
			</marker>
			<v n="26">and his children become a blessing .</v>
			<marker class="begin-verse" mid="v19037027">
			</marker>
			<v n="27">so shall you<crossref let="p" cid="c19037027.2" />dwell forever .</v>
			<marker class="begin-verse" mid="v19037028">
			</marker>
			<v n="28">but the children of the wicked shall be<crossref let="s" cid="c19037028.3" />cut off .</v>
			<marker class="begin-verse" mid="v19037029">
			</marker>
			<v n="29">and<crossref let="p" cid="c19037029.1" />dwell upon it forever .</v>
			<marker class="begin-verse" mid="v19037030">
			</marker>
			<v n="30">and his tongue speaks justice .</v>
			<marker class="begin-verse" mid="v19037031">
			</marker>
			<v n="31">his<crossref let="u" cid="c19037031.2" />steps do not slip .</v>
			<marker class="begin-verse" mid="v19037032">
			</marker>
			<v n="32">and seeks to put him to death .</v>
			<marker class="begin-verse" mid="v19037033">
			</marker>
			<v n="33">or let him<crossref let="x" cid="c19037033.2" />be condemned when he is brought to trial .</v>
			<marker class="begin-verse" mid="v19037034">
			</marker>
			<v n="34">you will look on<crossref let="z" cid="c19037034.2" />when the wicked are cut off .</v>
			<marker class="begin-verse" mid="v19037035">
			</marker>
			<v n="35">spreading himself like<crossref let="b" cid="c19037035.2" />a green laurel tree .</v>
			<marker class="begin-verse" mid="v19037036">
			</marker>
			<v n="36">though I sought him , he could not be found .</v>
			<marker class="begin-verse" mid="v19037037">
			</marker>
			<v n="37">for there is a future for the man of<crossref let="d" cid="c19037037.1" />peace .</v>
			<marker class="begin-verse" mid="v19037038">
			</marker>
			<v n="38">the future of the wicked<crossref let="f" cid="c19037038.2" />shall be cut off .</v>
			<marker class="begin-verse" mid="v19037039">
			</marker>
			<v n="39">he is their stronghold in<crossref let="h" cid="c19037039.2" />the time of trouble .</v>
			<marker class="begin-verse" mid="v19037040">
			</marker>
			<v n="40">because they<crossref let="k" cid="c19037040.3" />take refuge in him .</v>
			<marker class="begin-verse" mid="v19037041">
			</marker>
			<end-paragraph>
			</end-paragraph>
			<footnotes>
				<footnotes-heading>Footnotes</footnotes-heading>
				<footnote id="1">37:1 This psalm is an acrostic poem, each stanza beginning with the successive letters of the Hebrew alphabet</footnote>
				<footnote id="2">37:3 Or *and feed on faithfulness*, or *and find safe pasture*</footnote>
				<footnote id="3">37:22 Hebrew *by him*</footnote>
				<footnote id="4">37:35 The identity of this tree is uncertain</footnote>
				<footnote id="5">37:36 Or *But one passed by*</footnote>
			</footnotes>
