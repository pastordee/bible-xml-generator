		<chapter num="23">
			<heading>
				Proverbs 23
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">observe carefully what is before you ,</v>
			<marker class="begin-verse" mid="v20023002">
			</marker>
			<v n="2">if you are given to appetite .</v>
			<marker class="begin-verse" mid="v20023003">
			</marker>
			<v n="3">for they are deceptive food .</v>
			<marker class="begin-verse" mid="v20023004">
			</marker>
			<v n="4">
				<crossref let="e" cid="c20023004.2" />be discerning enough to desist .</v>
			<marker class="begin-verse" mid="v20023005">
			</marker>
			<v n="5">flying like an eagle toward heaven .</v>
			<marker class="begin-verse" mid="v20023006">
			</marker>
			<v n="6">
				<crossref let="i" cid="c20023006.3" />do not desire his delicacies ,</v>
			<marker class="begin-verse" mid="v20023007">
			</marker>
			<v n="7">but his<crossref let="j" cid="c20023007.1" />heart is not with you .</v>
			<marker class="begin-verse" mid="v20023008">
			</marker>
			<v n="8">and waste your pleasant words .</v>
			<marker class="begin-verse" mid="v20023009">
			</marker>
			<v n="9">for he will despise the good sense of your words .</v>
			<marker class="begin-verse" mid="v20023010">
			</marker>
			<v n="10">or enter the fields of the fatherless ,</v>
			<marker class="begin-verse" mid="v20023011">
			</marker>
			<v n="11">he will<crossref let="m" cid="c20023011.2" />plead their cause against you .</v>
			<marker class="begin-verse" mid="v20023012">
			</marker>
			<v n="12">and your ear to words of knowledge .</v>
			<marker class="begin-verse" mid="v20023013">
			</marker>
			<v n="13">
				<crossref let="o" cid="c20023013.2" />if you strike him with a rod , he will not die .</v>
			<marker class="begin-verse" mid="v20023014">
			</marker>
			<v n="14">you will<crossref let="p" cid="c20023014.1" />save his soul from Sheol .</v>
			<marker class="begin-verse" mid="v20023015">
			</marker>
			<v n="15">my heart too will be glad .</v>
			<marker class="begin-verse" mid="v20023016">
			</marker>
			<v n="16">when your lips speak<crossref let="s" cid="c20023016.2" />what is right .</v>
			<marker class="begin-verse" mid="v20023017">
			</marker>
			<v n="17">but continue in<crossref let="u" cid="c20023017.2" />the fear of the Lord all the day .</v>
			<marker class="begin-verse" mid="v20023018">
			</marker>
			<v n="18">and your<crossref let="w" cid="c20023018.2" />hope will not be cut off .</v>
			<marker class="begin-verse" mid="v20023019">
			</marker>
			<v n="19">and<crossref let="y" cid="c20023019.2" />direct your heart in the way .</v>
			<marker class="begin-verse" mid="v20023020">
			</marker>
			<v n="20">or among<crossref let="a" cid="c20023020.1" />gluttonous eaters of meat ,</v>
			<marker class="begin-verse" mid="v20023021">
			</marker>
			<v n="21">and<crossref let="b" cid="c20023021.1" />slumber will clothe them with rags .</v>
			<marker class="begin-verse" mid="v20023022">
			</marker>
			<v n="22">
				<crossref let="d" cid="c20023022.2" />and do not despise your mother when she is old .</v>
			<marker class="begin-verse" mid="v20023023">
			</marker>
			<v n="23">buy wisdom , instruction , and understanding .</v>
			<marker class="begin-verse" mid="v20023024">
			</marker>
			<v n="24">he who fathers a wise son will be glad in him .</v>
			<marker class="begin-verse" mid="v20023025">
			</marker>
			<v n="25">let<crossref let="g" cid="c20023025.2" />her who bore you rejoice .</v>
			<marker class="begin-verse" mid="v20023026">
			</marker>
			<v n="26">and let your eyes observe my ways .</v>
			<marker class="begin-verse" mid="v20023027">
			</marker>
			<v n="27">
				<crossref let="i" cid="c20023027.2" />an adulteress is a narrow<crossref let="j" cid="c20023027.3" />well .</v>
			<marker class="begin-verse" mid="v20023028">
			</marker>
			<v n="28">and increases the traitors among mankind .</v>
			<marker class="begin-verse" mid="v20023029">
			</marker>
			<v n="29">Who has<crossref let="n" cid="c20023029.3" />redness of eyes ?</v>
			<marker class="begin-verse" mid="v20023030">
			</marker>
			<v n="30">those who go to try<crossref let="p" cid="c20023030.2" />mixed wine .</v>
			<marker class="begin-verse" mid="v20023031">
			</marker>
			<v n="31">and goes down smoothly .</v>
			<marker class="begin-verse" mid="v20023032">
			</marker>
			<v n="32">and stings like an adder .</v>
			<marker class="begin-verse" mid="v20023033">
			</marker>
			<v n="33">and your heart utter<crossref let="r" cid="c20023033.1" />perverse things .</v>
			<marker class="begin-verse" mid="v20023034">
			</marker>
			<v n="34">like one who lies on the top of a mast .</v>
			<marker class="begin-verse" mid="v20023035">
			</marker>
			<v n="35">I<crossref let="t" cid="c20023035.2" />must have another drink . ”</v>
			<marker class="begin-verse" mid="v20023036">
			</marker>
			<end-paragraph>
			</end-paragraph>
