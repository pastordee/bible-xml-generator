			<marker class="begin-verse" mid="v19104020">
			</marker>
			<v n="20">
				You make 
				<crossref let="n" cid="c19104020.39">
				</crossref>
				darkness, and, 
				<crossref let="o" cid="c19104020.40">
				</crossref>
