			<heading>
				Why Have You Forsaken Me?
			</heading>
			<heading>
				To the choirmaster: according to The Doe of the Dawn. A Psalm of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">groaning?</v>
			<marker class="begin-verse" mid="v19022002">
			</marker>
			<v n="2">and by night, but I find no rest.</v>
			<marker class="begin-verse" mid="v19022003">
			</marker>
			<v n="3">the praises of Israel.</v>
			<marker class="begin-verse" mid="v19022004">
			</marker>
			<v n="4">they trusted, and you delivered them.</v>
			<marker class="begin-verse" mid="v19022005">
			</marker>
			<v n="5">trusted and were not put to shame.</v>
			<marker class="begin-verse" mid="v19022006">
			</marker>
			<v n="6">despised by the people.</v>
			<marker class="begin-verse" mid="v19022007">
			</marker>
			<v n="7">wag their heads;</v>
			<marker class="begin-verse" mid="v19022008">
			</marker>
			<v n="8">delights in him!”</v>
			<marker class="begin-verse" mid="v19022009">
			</marker>
			<v n="9">you made me trust you at my mother's breasts.</v>
			<marker class="begin-verse" mid="v19022010">
			</marker>
			<v n="10">my mother's womb you have been my God.</v>
			<marker class="begin-verse" mid="v19022011">
			</marker>
			<v n="11">none to help.</v>
			<marker class="begin-verse" mid="v19022012">
			</marker>
			<v n="12">Bashan surround me;</v>
			<marker class="begin-verse" mid="v19022013">
			</marker>
			<v n="13">like a ravening and roaring lion.</v>
			<marker class="begin-verse" mid="v19022014">
			</marker>
			<v n="14">it is melted within my breast;</v>
			<marker class="begin-verse" mid="v19022015">
			</marker>
			<v n="15">you lay me in the dust of death.</v>
			<marker class="begin-verse" mid="v19022016">
			</marker>
			<v n="16">pierced my hands and feet —</v>
			<marker class="begin-verse" mid="v19022017">
			</marker>
			<v n="17">stare and gloat over me;</v>
			<marker class="begin-verse" mid="v19022018">
			</marker>
			<v n="18">and for my clothing they cast lots.</v>
			<marker class="begin-verse" mid="v19022019">
			</marker>
			<v n="19">come quickly to my aid!</v>
			<marker class="begin-verse" mid="v19022020">
			</marker>
			<v n="20">the dog!</v>
			<marker class="begin-verse" mid="v19022021">
			</marker>
			<v n="21">the wild oxen!</v>
			<marker class="begin-verse" mid="v19022022">
			</marker>
			<v n="22">in the midst of the congregation I will praise you:</v>
			<marker class="begin-verse" mid="v19022023">
			</marker>
			<v n="23">and stand in awe of him, all you offspring of Israel!</v>
			<marker class="begin-verse" mid="v19022024">
			</marker>
			<v n="24">cried to him.</v>
			<marker class="begin-verse" mid="v19022025">
			</marker>
			<v n="25">perform before those who fear him.</v>
			<marker class="begin-verse" mid="v19022026">
			</marker>
			<v n="26">live forever!</v>
			<marker class="begin-verse" mid="v19022027">
			</marker>
			<v n="27">shall worship before you.</v>
			<marker class="begin-verse" mid="v19022028">
			</marker>
			<v n="28">and he rules over the nations.</v>
			<marker class="begin-verse" mid="v19022029">
			</marker>
			<v n="29">keep himself alive.</v>
			<marker class="begin-verse" mid="v19022030">
			</marker>
			<v n="30">generation;</v>
			<marker class="begin-verse" mid="v19022031">
			</marker>
			<v n="31">that he has done it.</v>
			<marker class="begin-verse" mid="v19022032">
			</marker>
