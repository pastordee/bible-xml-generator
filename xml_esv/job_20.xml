			</v>
			<marker class="begin-verse" mid="v18020008">
			</marker>
			<v n="8">
				He will 
				<crossref let="p" cid="c18020008.15">
				</crossref>
				fly away, 
				<crossref let="q" cid="c18020008.16">
				</crossref>
				like a dream and not be found; he will be chased away like a vision of the night.
			</v>
			<marker class="begin-verse" mid="v18020009">
			</marker>
			<v n="9">
				The eye 
				<crossref let="r" cid="c18020009.17">
				</crossref>
				that saw, 
				<crossref let="s" cid="c18020009.18">
				</crossref>
