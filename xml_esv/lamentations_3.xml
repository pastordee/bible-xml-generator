			<marker class="begin-verse" mid="v25003058">
			</marker>
			<v n="58">
				“You have 
				<crossref let="l" cid="c25003058.115">
				</crossref>
				taken up, 
				<crossref let="m" cid="c25003058.116">
				</crossref>
				my cause, O Lord; you have redeemed my life.
			</v>
			<marker class="begin-verse" mid="v25003059">
			</marker>
			<v n="59">
				You have 
				<crossref let="n" cid="c25003059.117">
				</crossref>
				seen the, 
				<crossref let="o" cid="c25003059.118">
				</crossref>
				wrong done to me, O LORD; judge my cause.
			</v>
			<marker class="begin-verse" mid="v25003060">
			</marker>
			<v n="60">
				You have 
				<crossref let="p" cid="c25003060.119">
				</crossref>
				seen all, 
				<crossref let="q" cid="c25003060.120">
				</crossref>
				their vengeance, all their plots against me.
				<note nid="n25003060.60">
				</note>
			</v>
			<marker class="begin-verse" mid="v25003061">
			</marker>
			<v n="61">
				“You have 
				<crossref let="r" cid="c25003061.121">
				</crossref>
				heard their, 
				<crossref let="s" cid="c25003061.122">
				</crossref>
				taunts, O LORD, all their plots against me.
			</v>
			<marker class="begin-verse" mid="v25003062">
			</marker>
			<v n="62">
				The lips 
				<crossref let="t" cid="c25003062.123">
				</crossref>
				and thoughts, 
				<crossref let="u" cid="c25003062.124">
				</crossref>
				of my assailants are against me all the day long.
			</v>
			<marker class="begin-verse" mid="v25003063">
			</marker>
			<v n="63">
				Behold their 
				<crossref let="v" cid="c25003063.125">
				</crossref>
				sitting and, 
				<crossref let="w" cid="c25003063.126">
				</crossref>
				their rising; I am the object of their taunts.
				<note nid="n25003063.63">
				</note>
			</v>
			<marker class="begin-verse" mid="v25003064">
			</marker>
			<v n="64">
				“You will 
				<crossref let="x" cid="c25003064.127">
				</crossref>
				repay them,(5), 
				<crossref let="y" cid="c25003064.128">
				</crossref>
				O LORD, according to the work of their hands.
			</v>
			<marker class="begin-verse" mid="v25003065">
			</marker>
