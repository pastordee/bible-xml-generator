		<chapter num="105">
			<heading>
				Psalm 105
			</heading>
			<heading>
				Tell of All His Wondrous Works
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">
				<crossref let="v" cid="c19105001.3" />make known his deeds among the peoples !</v>
			<marker class="begin-verse" mid="v19105002">
			</marker>
			<v n="2">
				<crossref let="w" cid="c19105002.1" />tell of all his wondrous works !</v>
			<marker class="begin-verse" mid="v19105003">
			</marker>
			<v n="3">let the hearts of those who seek the Lord rejoice !</v>
			<marker class="begin-verse" mid="v19105004">
			</marker>
			<v n="4">
				<crossref let="y" cid="c19105004.2" />seek his presence continually !</v>
			<marker class="begin-verse" mid="v19105005">
			</marker>
			<v n="5">his miracles , and<crossref let="a" cid="c19105005.1" />the judgments he uttered ,</v>
			<marker class="begin-verse" mid="v19105006">
			</marker>
			<v n="6">children of Jacob , his<crossref let="c" cid="c19105006.2" />chosen ones !</v>
			<marker class="begin-verse" mid="v19105007">
			</marker>
			<v n="7">his<crossref let="d" cid="c19105007.1" />judgments are in all the earth .</v>
			<marker class="begin-verse" mid="v19105008">
			</marker>
			<v n="8">the word that he commanded , for<crossref let="f" cid="c19105008.2" />a thousand generations ,</v>
			<marker class="begin-verse" mid="v19105009">
			</marker>
			<v n="9">his<crossref let="h" cid="c19105009.2" />sworn promise to Isaac ,</v>
			<marker class="begin-verse" mid="v19105010">
			</marker>
			<v n="10">to Israel as an everlasting covenant ,</v>
			<marker class="begin-verse" mid="v19105011">
			</marker>
			<v n="11">as<crossref let="k" cid="c19105011.2" />your portion for an inheritance . ”</v>
			<marker class="begin-verse" mid="v19105012">
			</marker>
			<v n="12">of little account , and<crossref let="m" cid="c19105012.2" />sojourners in it ,</v>
			<marker class="begin-verse" mid="v19105013">
			</marker>
			<v n="13">from one kingdom to another people ,</v>
			<marker class="begin-verse" mid="v19105014">
			</marker>
			<v n="14">he<crossref let="o" cid="c19105014.2" />rebuked kings on their account ,</v>
			<marker class="begin-verse" mid="v19105015">
			</marker>
			<v n="15">do my prophets no harm ! ”</v>
			<marker class="begin-verse" mid="v19105016">
			</marker>
			<v n="16">and<crossref let="r" cid="c19105016.2" />broke all supply of bread ,</v>
			<marker class="begin-verse" mid="v19105017">
			</marker>
			<v n="17">Joseph , who was<crossref let="t" cid="c19105017.2" />sold as a slave .</v>
			<marker class="begin-verse" mid="v19105018">
			</marker>
			<v n="18">his neck was put in a collar of iron ;</v>
			<marker class="begin-verse" mid="v19105019">
			</marker>
			<v n="19">the word of the Lord<crossref let="w" cid="c19105019.2" />tested him .</v>
			<marker class="begin-verse" mid="v19105020">
			</marker>
			<v n="20">the ruler of the peoples set him free ;</v>
			<marker class="begin-verse" mid="v19105021">
			</marker>
			<v n="21">and ruler of all his possessions ,</v>
			<marker class="begin-verse" mid="v19105022">
			</marker>
			<v n="22">and to teach his elders wisdom .</v>
			<marker class="begin-verse" mid="v19105023">
			</marker>
			<v n="23">Jacob<crossref let="b" cid="c19105023.2" />sojourned in<crossref let="c" cid="c19105023.3" />the land of Ham .</v>
			<marker class="begin-verse" mid="v19105024">
			</marker>
			<v n="24">and made them stronger than their foes .</v>
			<marker class="begin-verse" mid="v19105025">
			</marker>
			<v n="25">to<crossref let="f" cid="c19105025.2" />deal craftily with his servants .</v>
			<marker class="begin-verse" mid="v19105026">
			</marker>
			<v n="26">and Aaron ,<crossref let="h" cid="c19105026.2" />whom he had chosen .</v>
			<marker class="begin-verse" mid="v19105027">
			</marker>
			<v n="27">and miracles in<crossref let="c" cid="c19105027.1" />the land of Ham .</v>
			<marker class="begin-verse" mid="v19105028">
			</marker>
			<v n="28">they<crossref let="k" cid="c19105028.2" />did not rebel against his words .</v>
			<marker class="begin-verse" mid="v19105029">
			</marker>
			<v n="29">and<crossref let="l" cid="c19105029.1" />caused their fish to die .</v>
			<marker class="begin-verse" mid="v19105030">
			</marker>
			<v n="30">even in<crossref let="m" cid="c19105030.1" />the chambers of their kings .</v>
			<marker class="begin-verse" mid="v19105031">
			</marker>
			<v n="31">
				<crossref let="o" cid="c19105031.2" />and gnats throughout their country .</v>
			<marker class="begin-verse" mid="v19105032">
			</marker>
			<v n="32">and fiery<crossref let="p" cid="c19105032.1" />lightning bolts through their land .</v>
			<marker class="begin-verse" mid="v19105033">
			</marker>
			<v n="33">and<crossref let="q" cid="c19105033.1" />shattered the trees of their country .</v>
			<marker class="begin-verse" mid="v19105034">
			</marker>
			<v n="34">young locusts without number ,</v>
			<marker class="begin-verse" mid="v19105035">
			</marker>
			<v n="35">and ate up the fruit of their ground .</v>
			<marker class="begin-verse" mid="v19105036">
			</marker>
			<v n="36">
				<crossref let="s" cid="c19105036.1" />the firstfruits of all their strength .</v>
			<marker class="begin-verse" mid="v19105037">
			</marker>
			<v n="37">and there was none among his tribes who stumbled .</v>
			<marker class="begin-verse" mid="v19105038">
			</marker>
			<v n="38">for<crossref let="v" cid="c19105038.2" />dread of them had fallen upon it .</v>
			<marker class="begin-verse" mid="v19105039">
			</marker>
			<v n="39">and fire to give light by night .</v>
			<marker class="begin-verse" mid="v19105040">
			</marker>
			<v n="40">and gave them<crossref let="z" cid="c19105040.3" />bread from heaven in abundance .</v>
			<marker class="begin-verse" mid="v19105041">
			</marker>
			<v n="41">it flowed through<crossref let="b" cid="c19105041.2" />the desert like a river .</v>
			<marker class="begin-verse" mid="v19105042">
			</marker>
			<v n="42">and<crossref let="d" cid="c19105042.2" />Abraham , his servant .</v>
			<marker class="begin-verse" mid="v19105043">
			</marker>
			<v n="43">his<crossref let="d" cid="c19105043.1" />chosen ones with<crossref let="e" cid="c19105043.2" />singing .</v>
			<marker class="begin-verse" mid="v19105044">
			</marker>
			<v n="44">and they took possession of the fruit of the peoples’ toil ,</v>
			<marker class="begin-verse" mid="v19105045">
			</marker>
			<v n="45">
				<crossref let="i" cid="c19105045.3" />Praise the Lord !</v>
			<marker class="begin-verse" mid="v19105046">
			</marker>
			<end-paragraph>
			</end-paragraph>
