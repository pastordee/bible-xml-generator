				<note nid="n19104006.6">
				</note>
			</v>
			<marker class="begin-verse" mid="v19104007">
			</marker>
			<v n="7">
				At your 
				<crossref let="n" cid="c19104007.13">
				</crossref>
				rebuke they, 
				<crossref let="o" cid="c19104007.14">
				</crossref>
