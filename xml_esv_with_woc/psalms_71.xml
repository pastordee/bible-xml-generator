		<chapter num="71">
			<heading>
				Psalm 71
			</heading>
			<heading>
				Forsake Me Not When My Strength Is Spent
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">let me never be put to shame!</v>
			<marker class="begin-verse" mid="v19071002">
			</marker>
			<v n="2">incline your ear to me, and save me!</v>
			<marker class="begin-verse" mid="v19071003">
			</marker>
			<v n="3">rock and my fortress.</v>
			<marker class="begin-verse" mid="v19071004">
			</marker>
			<v n="4">from the grasp of the unjust and cruel man.</v>
			<marker class="begin-verse" mid="v19071005">
			</marker>
			<v n="5">my trust, O Lord , from my youth.</v>
			<marker class="begin-verse" mid="v19071006">
			</marker>
			<v n="6">My praise is continually of you.</v>
			<marker class="begin-verse" mid="v19071007">
			</marker>
			<v n="7">but you are my strong refuge.</v>
			<marker class="begin-verse" mid="v19071008">
			</marker>
			<v n="8">and with your glory all the day.</v>
			<marker class="begin-verse" mid="v19071009">
			</marker>
			<v n="9">forsake me not when my strength is spent.</v>
			<marker class="begin-verse" mid="v19071010">
			</marker>
			<v n="10">consult together</v>
			<marker class="begin-verse" mid="v19071011">
			</marker>
			<v n="11">for there is none to deliver him.”</v>
			<marker class="begin-verse" mid="v19071012">
			</marker>
			<v n="12">make haste to help me!</v>
			<marker class="begin-verse" mid="v19071013">
			</marker>
			<v n="13">seek my hurt.</v>
			<marker class="begin-verse" mid="v19071014">
			</marker>
			<v n="14">praise you yet more and more.</v>
			<marker class="begin-verse" mid="v19071015">
			</marker>
			<v n="15">their number is past my knowledge.</v>
			<marker class="begin-verse" mid="v19071016">
			</marker>
			<v n="16">I will remind them of your righteousness, yours alone.</v>
			<marker class="begin-verse" mid="v19071017">
			</marker>
			<v n="17">and I still proclaim your wondrous deeds.</v>
			<marker class="begin-verse" mid="v19071018">
			</marker>
			<v n="18">your power to all those to come.</v>
			<marker class="begin-verse" mid="v19071019">
			</marker>
			<v n="19">who is like you?</v>
			<marker class="begin-verse" mid="v19071020">
			</marker>
			<v n="20">you will bring me up again.</v>
			<marker class="begin-verse" mid="v19071021">
			</marker>
			<v n="21">and comfort me again.</v>
			<marker class="begin-verse" mid="v19071022">
			</marker>
			<v n="22">Holy One of Israel.</v>
			<marker class="begin-verse" mid="v19071023">
			</marker>
			<v n="23">redeemed.</v>
			<marker class="begin-verse" mid="v19071024">
			</marker>
			<v n="24">who sought to do me hurt.</v>
			<marker class="begin-verse" mid="v19071025">
			</marker>
