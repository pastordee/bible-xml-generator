			</v>
			<marker class="begin-verse" mid="v18020018">
			</marker>
			<v n="18">
				He will 
				<crossref let="j" cid="c18020018.35">
				</crossref>
				give back, 
				<crossref let="k" cid="c18020018.36">
				</crossref>
