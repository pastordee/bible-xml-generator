			<marker class="begin-verse" mid="v20020025">
			</marker>
			<v n="25">and to reflect only<crossref let="o" cid="c20020025.1" />after making vows .</v>
			<marker class="begin-verse" mid="v20020026">
			</marker>
			<v n="26">and drives<crossref let="q" cid="c20020026.2" />the wheel over them .</v>
			<marker class="begin-verse" mid="v20020027">
			</marker>
			<v n="27">
				<crossref let="s" cid="c20020027.2" />searching all<crossref let="t" cid="c20020027.3" />his innermost parts .</v>
			<marker class="begin-verse" mid="v20020028">
			</marker>
			<v n="28">and by steadfast love his<crossref let="v" cid="c20020028.2" />throne is upheld .</v>
			<marker class="begin-verse" mid="v20020029">
			</marker>
			<v n="29">but<crossref let="w" cid="c20020029.1" />the splendor of old men is their gray hair .</v>
			<marker class="begin-verse" mid="v20020030">
			</marker>
