		<chapter num="16">
			<heading>
				Proverbs 16
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">but<crossref let="l" cid="c20016001.1" />the answer of the tongue is from the Lord .</v>
			<marker class="begin-verse" mid="v20016002">
			</marker>
			<v n="2">but the Lord<crossref let="n" cid="c20016002.2" />weighs the spirit .</v>
			<marker class="begin-verse" mid="v20016003">
			</marker>
			<v n="3">and your plans will be established .</v>
			<marker class="begin-verse" mid="v20016004">
			</marker>
			<v n="4">even<crossref let="q" cid="c20016004.2" />the wicked for the day of trouble .</v>
			<marker class="begin-verse" mid="v20016005">
			</marker>
			<v n="5">
				<crossref let="s" cid="c20016005.2" />be assured , he will not go unpunished .</v>
			<marker class="begin-verse" mid="v20016006">
			</marker>
			<v n="6">and by<crossref let="u" cid="c20016006.2" />the fear of the Lord one<crossref let="v" cid="c20016006.3" />turns away from evil .</v>
			<marker class="begin-verse" mid="v20016007">
			</marker>
			<v n="7">
				<crossref let="w" cid="c20016007.1" />he makes even his enemies to be at peace with him .</v>
			<marker class="begin-verse" mid="v20016008">
			</marker>
			<v n="8">than great revenues with injustice .</v>
			<marker class="begin-verse" mid="v20016009">
			</marker>
			<v n="9">but<crossref let="z" cid="c20016009.2" />the Lord establishes his steps .</v>
			<marker class="begin-verse" mid="v20016010">
			</marker>
			<v n="10">his mouth does not sin in judgment .</v>
			<marker class="begin-verse" mid="v20016011">
			</marker>
			<v n="11">all the weights in the bag are his work .</v>
			<marker class="begin-verse" mid="v20016012">
			</marker>
			<v n="12">for<crossref let="c" cid="c20016012.1" />the throne is established by righteousness .</v>
			<marker class="begin-verse" mid="v20016013">
			</marker>
			<v n="13">and he loves him who speaks what is right .</v>
			<marker class="begin-verse" mid="v20016014">
			</marker>
			<v n="14">and a wise man will<crossref let="f" cid="c20016014.2" />appease it .</v>
			<marker class="begin-verse" mid="v20016015">
			</marker>
			<v n="15">and his<crossref let="d" cid="c20016015.1" />favor is like<crossref let="h" cid="c20016015.3" />the clouds that bring the spring rain .</v>
			<marker class="begin-verse" mid="v20016016">
			</marker>
			<v n="16">To get understanding is to be chosen rather than<crossref let="k" cid="c20016016.3" />silver .</v>
			<marker class="begin-verse" mid="v20016017">
			</marker>
			<v n="17">whoever guards his way preserves his life .</v>
			<marker class="begin-verse" mid="v20016018">
			</marker>
			<v n="18">and a haughty spirit before a fall .</v>
			<marker class="begin-verse" mid="v20016019">
			</marker>
			<v n="19">than to<crossref let="o" cid="c20016019.2" />divide the spoil with the proud .</v>
			<marker class="begin-verse" mid="v20016020">
			</marker>
			<v n="20">and blessed is he<crossref let="q" cid="c20016020.2" />who trusts in the Lord .</v>
			<marker class="begin-verse" mid="v20016021">
			</marker>
			<v n="21">and sweetness of speech<crossref let="r" cid="c20016021.1" />increases persuasiveness .</v>
			<marker class="begin-verse" mid="v20016022">
			</marker>
			<v n="22">but the instruction of fools is folly .</v>
			<marker class="begin-verse" mid="v20016023">
			</marker>
			<v n="23">and adds persuasiveness to his lips .</v>
			<marker class="begin-verse" mid="v20016024">
			</marker>
			<v n="24">sweetness to the soul and<crossref let="w" cid="c20016024.3" />health to the body .</v>
			<marker class="begin-verse" mid="v20016025">
			</marker>
			<v n="25">but its end is the way to death .</v>
			<marker class="begin-verse" mid="v20016026">
			</marker>
			<v n="26">his<crossref let="x" cid="c20016026.1" />mouth urges him on .</v>
			<marker class="begin-verse" mid="v20016027">
			</marker>
			<v n="27">and his speech is like<crossref let="z" cid="c20016027.2" />a scorching fire .</v>
			<marker class="begin-verse" mid="v20016028">
			</marker>
			<v n="28">and<crossref let="b" cid="c20016028.2" />a whisperer<crossref let="c" cid="c20016028.3" />separates close friends .</v>
			<marker class="begin-verse" mid="v20016029">
			</marker>
			<v n="29">and leads him in a way that is not good .</v>
			<marker class="begin-verse" mid="v20016030">
			</marker>
			<v n="30">he who<crossref let="f" cid="c20016030.2" />purses his lips brings evil to pass .</v>
			<marker class="begin-verse" mid="v20016031">
			</marker>
			<v n="31">it<crossref let="i" cid="c20016031.3" />is gained in a righteous life .</v>
			<marker class="begin-verse" mid="v20016032">
			</marker>
			<v n="32">and he who rules his spirit than he who takes a city .</v>
			<marker class="begin-verse" mid="v20016033">
			</marker>
			<v n="33">but its every decision is<crossref let="l" cid="c20016033.2" />from the Lord .</v>
			<marker class="begin-verse" mid="v20016034">
			</marker>
			<end-paragraph>
			</end-paragraph>
