				<footnote id="3">119:13 Or *all the just decrees*</footnote>
				<footnote id="4">119:20 Or *your just decrees*; also verses 30, 39, 43, 52, 75, 102, 108, 137, 156, 175</footnote>
				<footnote id="5">119:32 Or *for you set my heart free*</footnote>
				<footnote id="6">119:33 Or *keep it as my reward*</footnote>
				<footnote id="7">119:84 Hebrew *How many are the days of your servant*?</footnote>
				<footnote id="8">119:100 Or *the elders*</footnote>
				<footnote id="9">119:112 Or *statutes; the reward is eternal*</footnote>
			</footnotes>
		</chapter>
	</book>
</bible>
