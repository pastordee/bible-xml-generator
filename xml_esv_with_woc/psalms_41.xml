			<heading>
				O LORD, Be Gracious to Me
			</heading>
			<heading>
				To the choirmaster. A Psalm of David.
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">
				<crossref let="f" cid="c19041001.2" />In the day of trouble the Lord delivers him;</v>
			<marker class="begin-verse" mid="v19041002">
			</marker>
			<v n="2">you<crossref let="g" cid="c19041002.1" />do not give him up to the will of his enemies.</v>
			<marker class="begin-verse" mid="v19041003">
			</marker>
			<v n="3">in his illness you restore him to full health.</v>
			<marker class="begin-verse" mid="v19041004">
			</marker>
			<v n="4">
				<crossref let="i" cid="c19041004.2" />heal me, for I have sinned against you!”</v>
			<marker class="begin-verse" mid="v19041005">
			</marker>
			<v n="5">“When will he die, and his name perish?”</v>
			<marker class="begin-verse" mid="v19041006">
			</marker>
			<v n="6">when he goes out, he tells it abroad.</v>
			<marker class="begin-verse" mid="v19041007">
			</marker>
			<v n="7">they imagine the worst for me.</v>
			<marker class="begin-verse" mid="v19041008">
			</marker>
			<v n="8">he will not rise again from where he lies.”</v>
			<marker class="begin-verse" mid="v19041009">
			</marker>
			<v n="9">who<crossref let="l" cid="c19041009.2" />ate my bread, has lifted his heel against me.</v>
			<marker class="begin-verse" mid="v19041010">
			</marker>
			<v n="10">and raise me up, that I may repay them!</v>
			<marker class="begin-verse" mid="v19041011">
			</marker>
			<v n="11">my enemy will not shout in triumph over me.</v>
			<marker class="begin-verse" mid="v19041012">
			</marker>
			<v n="12">and<crossref let="p" cid="c19041012.3" />set me in your presence<crossref let="q" cid="c19041012.4" />forever.</v>
			<marker class="begin-verse" mid="v19041013">
			</marker>
			<v n="13">Amen and Amen.</v>
			<marker class="begin-verse" mid="v19041014">
			</marker>
