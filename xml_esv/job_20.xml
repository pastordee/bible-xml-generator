			</v>
			<marker class="begin-verse" mid="v18020024">
			</marker>
			<v n="24">
				He will 
				<crossref let="v" cid="c18020024.47">
				</crossref>
				flee from, 
				<crossref let="w" cid="c18020024.48">
				</crossref>
