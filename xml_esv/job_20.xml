			</v>
			<marker class="begin-verse" mid="v18020015">
			</marker>
			<v n="15">
				He swallows 
				<crossref let="d" cid="c18020015.29">
				</crossref>
				down riches, 
				<crossref let="e" cid="c18020015.30">
				</crossref>
