			<heading>
				Great Is Your Faithfulness
			</heading>
			<begin-paragraph>
			</begin-paragraph>
			<v n="1">rod of his wrath;</v>
			<marker class="begin-verse" mid="v25003002">
			</marker>
			<v n="2">into darkness without any light;</v>
			<marker class="begin-verse" mid="v25003003">
			</marker>
			<v n="3">again and again the whole day long.</v>
			<marker class="begin-verse" mid="v25003004">
			</marker>
			<v n="4">he has broken my bones;</v>
			<marker class="begin-verse" mid="v25003005">
			</marker>
			<v n="5">bitterness and tribulation;</v>
			<marker class="begin-verse" mid="v25003006">
			</marker>
			<v n="6">like the dead of long ago.</v>
			<marker class="begin-verse" mid="v25003007">
			</marker>
			<v n="7">he has made my chains heavy;</v>
			<marker class="begin-verse" mid="v25003008">
			</marker>
			<v n="8">he shuts out my prayer;</v>
			<marker class="begin-verse" mid="v25003009">
			</marker>
			<v n="9">he has made my paths crooked.</v>
			<marker class="begin-verse" mid="v25003010">
			</marker>
			<v n="10">a lion in hiding;</v>
			<marker class="begin-verse" mid="v25003011">
			</marker>
			<v n="11">he has made me desolate;</v>
			<marker class="begin-verse" mid="v25003012">
			</marker>
			<v n="12">as a target for his arrow.</v>
			<marker class="begin-verse" mid="v25003013">
			</marker>
			<v n="13">the arrows of his quiver;</v>
			<marker class="begin-verse" mid="v25003014">
			</marker>
			<v n="14">the object of their taunts all day long.</v>
			<marker class="begin-verse" mid="v25003015">
			</marker>
			<v n="15">wormwood.</v>
			<marker class="begin-verse" mid="v25003016">
			</marker>
			<v n="16">made me cower in ashes;</v>
			<marker class="begin-verse" mid="v25003017">
			</marker>
			<v n="17">I have forgotten what happiness is;</v>
			<marker class="begin-verse" mid="v25003018">
			</marker>
			<v n="18">so has my hope from the Lord .”</v>
			<marker class="begin-verse" mid="v25003019">
			</marker>
			<v n="19">the gall!</v>
			<marker class="begin-verse" mid="v25003020">
			</marker>
			<v n="20">and is bowed down within me.</v>
			<marker class="begin-verse" mid="v25003021">
			</marker>
			<v n="21">therefore I have hope:</v>
			<marker class="begin-verse" mid="v25003022">
			</marker>
			<v n="22">his mercies never come to an end;</v>
			<marker class="begin-verse" mid="v25003023">
			</marker>
			<v n="23">great is your faithfulness.</v>
			<marker class="begin-verse" mid="v25003024">
			</marker>
			<v n="24">“therefore I will hope in him.”</v>
			<marker class="begin-verse" mid="v25003025">
			</marker>
			<v n="25">to the soul who seeks him.</v>
			<marker class="begin-verse" mid="v25003026">
			</marker>
			<v n="26">for the salvation of the Lord .</v>
			<marker class="begin-verse" mid="v25003027">
			</marker>
			<v n="27">in his youth.</v>
			<marker class="begin-verse" mid="v25003028">
			</marker>
			<v n="28">when it is laid on him;</v>
			<marker class="begin-verse" mid="v25003029">
			</marker>
			<v n="29">there may yet be hope;</v>
			<marker class="begin-verse" mid="v25003030">
			</marker>
			<v n="30">and let him be filled with insults.</v>
			<marker class="begin-verse" mid="v25003031">
			</marker>
			<v n="31">cast off forever,</v>
			<marker class="begin-verse" mid="v25003032">
			</marker>
			<v n="32">according to the abundance of his steadfast love;</v>
			<marker class="begin-verse" mid="v25003033">
			</marker>
			<v n="33">grieve the children of men.</v>
			<marker class="begin-verse" mid="v25003034">
			</marker>
			<v n="34">the prisoners of the earth,</v>
			<marker class="begin-verse" mid="v25003035">
			</marker>
			<v n="35">in the presence of the Most High,</v>
			<marker class="begin-verse" mid="v25003036">
			</marker>
			<v n="36">the Lord does not approve.</v>
			<marker class="begin-verse" mid="v25003037">
			</marker>
			<v n="37">unless the Lord has commanded it?</v>
			<marker class="begin-verse" mid="v25003038">
			</marker>
			<v n="38">that good and bad come?</v>
			<marker class="begin-verse" mid="v25003039">
			</marker>
			<v n="39">a man, about the punishment of his sins?</v>
			<marker class="begin-verse" mid="v25003040">
			</marker>
			<v n="40">and return to the Lord !</v>
			<marker class="begin-verse" mid="v25003041">
			</marker>
			<v n="41">to God in heaven:</v>
			<marker class="begin-verse" mid="v25003042">
			</marker>
			<v n="42">and you have not forgiven.</v>
			<marker class="begin-verse" mid="v25003043">
			</marker>
			<v n="43">killing without pity;</v>
			<marker class="begin-verse" mid="v25003044">
			</marker>
			<v n="44">so that no prayer can pass through.</v>
			<marker class="begin-verse" mid="v25003045">
			</marker>
			<v n="45">among the peoples.</v>
			<marker class="begin-verse" mid="v25003046">
			</marker>
			<v n="46">open their mouths against us;</v>
			<marker class="begin-verse" mid="v25003047">
			</marker>
			<v n="47">destruction;</v>
			<marker class="begin-verse" mid="v25003048">
			</marker>
			<v n="48">because of the destruction of the daughter of my people.</v>
			<marker class="begin-verse" mid="v25003049">
			</marker>
			<v n="49">without respite,</v>
			<marker class="begin-verse" mid="v25003050">
			</marker>
			<v n="50">looks down and sees;</v>
			<marker class="begin-verse" mid="v25003051">
			</marker>
			<v n="51">at the fate of all the daughters of my city.</v>
			<marker class="begin-verse" mid="v25003052">
			</marker>
			<v n="52">without cause;</v>
			<marker class="begin-verse" mid="v25003053">
			</marker>
			<v n="53">and cast stones on me;</v>
			<marker class="begin-verse" mid="v25003054">
			</marker>
			<v n="54">‘I am lost.’</v>
			<marker class="begin-verse" mid="v25003055">
			</marker>
			<v n="55">from the depths of the pit;</v>
			<marker class="begin-verse" mid="v25003056">
			</marker>
			<v n="56">your ear to my cry for help!’</v>
			<marker class="begin-verse" mid="v25003057">
			</marker>
			<v n="57">‘Do not fear!’</v>
			<marker class="begin-verse" mid="v25003058">
			</marker>
			<v n="58">redeemed my life.</v>
			<marker class="begin-verse" mid="v25003059">
			</marker>
			<v n="59">judge my cause.</v>
			<marker class="begin-verse" mid="v25003060">
			</marker>
			<v n="60">their plots against me.</v>
			<marker class="begin-verse" mid="v25003061">
			</marker>
			<v n="61">their plots against me.</v>
			<marker class="begin-verse" mid="v25003062">
			</marker>
			<v n="62">are against me all the day long.</v>
			<marker class="begin-verse" mid="v25003063">
			</marker>
			<v n="63">I am the object of their taunts.</v>
			<marker class="begin-verse" mid="v25003064">
			</marker>
			<v n="64">according to the work of their hands.</v>
			<marker class="begin-verse" mid="v25003065">
			</marker>
			<v n="65">your curse will be on them.</v>
			<marker class="begin-verse" mid="v25003066">
			</marker>
			<v n="66">your heavens, O Lord .”</v>
			<marker class="begin-verse" mid="v25003067">
			</marker>
