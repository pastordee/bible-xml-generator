				</note>
			</v>
			<marker class="begin-verse" mid="v18038004">
			</marker>
			<v n="4">
				“Where were 
				<crossref let="h" cid="c18038004.7">
				</crossref>
				you when, 
				<crossref let="i" cid="c18038004.8">
				</crossref>
